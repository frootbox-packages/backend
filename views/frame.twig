{#- The HTML document of every backend page. Screens extend layout.twig. -#}
<!doctype html>
<html lang="{{ fb.language }}">
<head>
{{ fb.head|raw }}
<title>{% block title %}{% endblock %} · {{ fb.brand }}</title>
</head>
<body data-fb-failed="{{ t('The server cannot be reached. Check the connection and try again.') }}">
{% block body %}{% endblock %}
</body>
</html>
