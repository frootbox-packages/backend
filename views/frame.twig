{#- The HTML document of every backend page. Screens extend layout.twig. -#}
<!doctype html>
<html lang="{{ fb.language }}" dir="{{ fb.direction }}">
<head>
{{ fb.head|raw }}
<title>{% block title %}{% endblock %} · {{ fb.brand }}</title>
</head>
<body data-fb-failed="{{ t('The server cannot be reached. Check the connection and try again.') }}" data-fb-unsaved="{{ t('Not saved') }}" data-fb-leave="{{ t('Your changes are not saved. Leave anyway?') }}" data-fb-copy-manually="{{ t('Copy the text:') }}">
{% block body %}{% endblock %}
</body>
</html>
