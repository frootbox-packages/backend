{#- A user: details, roles, password and deleting, each a form of its own (decision 0115). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% set user = profile.user %}
{% set service = user.kind.value == 'service' %}
{% block title %}{{ user.name }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <p class="fb-muted"><a href="{{ path('backend.users') }}">{{ t('Users') }}</a></p>
            <h1 class="fb-heading-1">{{ user.name }}</h1>
        </div>
        {% if service %}{{ ui.badge('neutral', t('Service account')) }}{% endif %}
        {% if not user.active %}{{ ui.badge('neutral', t('Disabled')) }}{% endif %}
        {%- for identity in identities|filter(i => i.managed) %}{{ ui.badge('neutral', t('through {provider}', {provider: identity.title})) }}{% endfor %}
    </header>
    {%- for identity in identities|filter(i => i.managed) %}
    {{ ui.alert({tone: 'info', text: t('Managed through {provider}: role and lock come from there. A change here lasts until the next sign-in or change there.', {provider: identity.title})}) }}
    {%- endfor %}

    {% if service %}<p class="fb-muted">{{ t('A service account never signs in. Programs use it with API tokens, with the rights of its roles.') }}</p>{% endif %}

    {% set editable = can('user.update') %}
    <section class="fb-card" aria-labelledby="fb-details-title">
        <div class="fb-card__header"><h2 class="fb-heading-4" id="fb-details-title">{{ t('Details') }}</h2></div>
        <div class="fb-card__body">
            <fb-form action="user.update" done="{{ t('Saved') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="id" value="{{ user.id }}" data-type="number">
                    {{ ui.field({label: t('Name'), name: 'name', value: user.name, required: true, disabled: not editable}) }}
                    {% if service %}
                        <input type="hidden" name="email" value="" data-empty="null">
                    {% else %}
                        {{ ui.field({label: t('Email'), name: 'email', type: 'email', value: user.email, required: true, disabled: not editable}) }}
                    {% endif %}
                    {% if yourself %}
                        <input type="hidden" name="active" value="1" data-type="boolean">
                    {% else %}
                        {{ ui.check({label: service ? t('Active') : t('May sign in'), name: 'active', checked: user.active, disabled: not editable, hint: service ? t('Without it the tokens of the service account stop working.') : t('Without it the user is signed out and cannot sign in.')}) }}
                    {% endif %}
                    {% if editable %}<div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}</div>{% endif %}
                </form>
            </fb-form>
        </div>
    </section>

    <section class="fb-card" aria-labelledby="fb-roles-title">
        <div class="fb-card__header"><h2 class="fb-heading-4" id="fb-roles-title">{{ t('Roles') }}</h2></div>
        <div class="fb-card__body">
            {% if can('user.set-roles') %}
            <fb-form action="user.set-roles" done="{{ t('The roles are saved.') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="userId" value="{{ user.id }}" data-type="number">
                    {% include '@backend/users/roles-field.twig' with {hide_legend: true} %}
                    <div class="fb-form__actions">{{ ui.button({label: t('Save the roles'), type: 'submit', saves: true}) }}</div>
                </form>
            </fb-form>
            {% else %}
                <p>{{ assigned is empty ? t('No roles') : assigned|map(name => titles[name] ?? name)|join(', ') }}</p>
            {% endif %}
        </div>
    </section>

    {% set may_assign = can('user.assign-role') and pages is not empty %}
    {% if scoped is not empty or may_assign %}
    <section class="fb-card" id="user-branches" aria-labelledby="user-branches-title">
        <div class="fb-card__header">
            <div class="fb-stack fb-stack--sm">
                <h2 class="fb-heading-4" id="user-branches-title" tabindex="-1" data-fb-focus>{{ t('Roles within branches') }}</h2>
                <p class="fb-muted">{{ t('A role here applies only to the page and everything below it. Media, navigations and the like need a role above.') }}</p>
            </div>
        </div>
        {% if scoped is not empty %}
        <ul class="fb-list">
            {%- for assignment in scoped %}
            <li class="fb-list__item">
                <div class="fb-list__main">
                    <span class="fb-list__title">{{ titles[assignment.role] ?? assignment.role }}</span>
                    <span class="fb-list__meta">{{ assignment.page ? assignment.page.title ~ ' · ' ~ assignment.page.path : t('The page is gone.') }}</span>
                </div>
                {% if can('user.remove-role') %}
                <fb-form action="user.remove-role" refresh="user-branches" done="{{ t('The role is taken away.') }}">
                    <form novalidate>
                        <input type="hidden" name="userId" value="{{ user.id }}" data-type="number">
                        <input type="hidden" name="role" value="{{ assignment.role }}">
                        <input type="hidden" name="scope" value="{{ assignment.scope }}">
                        {{ ui.button({label: t('Take away'), type: 'submit', variant: 'ghost', small: true}) }}
                    </form>
                </fb-form>
                {% endif %}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
        {% if may_assign %}
        <div class="fb-card__body">
            <fb-form action="user.assign-role" refresh="user-branches" done="{{ t('The role is given.') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="userId" value="{{ user.id }}" data-type="number">
                    {{ ui.select({label: t('Role'), name: 'role', id: 'user-branch-role', options: roles|map(role => {value: role.name, label: role.title})}) }}
                    {{ ui.select({label: t('Page'), name: 'scope', id: 'user-branch-page', options: pages, hint: t('With all pages below it.')}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Give the role'), type: 'submit', variant: 'outline'}) }}</div>
                </form>
            </fb-form>
        </div>
        {% endif %}
    </section>
    {% endif %}
    {% set may_assign_space = can('user.assign-role') and spaces is not empty %}
    {% if inSpaces is not empty or may_assign_space %}
    <section class="fb-card" id="user-spaces" aria-labelledby="user-spaces-title">
        <div class="fb-card__header">
            <div class="fb-stack fb-stack--sm">
                <h2 class="fb-heading-4" id="user-spaces-title" tabindex="-1" data-fb-focus>{{ t('Roles within spaces') }}</h2>
                <p class="fb-muted">{{ t('A role here applies only to the entries of the space, e.g. the jobs of the apprenticeships. Categories and the spaces themselves need a role above.') }}</p>
            </div>
        </div>
        {% if inSpaces is not empty %}
        <ul class="fb-list">
            {%- for assignment in inSpaces %}
            <li class="fb-list__item">
                <div class="fb-list__main">
                    <span class="fb-list__title">{{ titles[assignment.role] ?? assignment.role }}</span>
                    <span class="fb-list__meta">{{ assignment.space ?? t('The space is gone.') }}</span>
                </div>
                {% if can('user.remove-role') %}
                <fb-form action="user.remove-role" refresh="user-spaces" done="{{ t('The role is taken away.') }}">
                    <form novalidate>
                        <input type="hidden" name="userId" value="{{ user.id }}" data-type="number">
                        <input type="hidden" name="role" value="{{ assignment.role }}">
                        <input type="hidden" name="scope" value="{{ assignment.scope }}">
                        {{ ui.button({label: t('Take away'), type: 'submit', variant: 'ghost', small: true}) }}
                    </form>
                </fb-form>
                {% endif %}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
        {% if may_assign_space %}
        <div class="fb-card__body">
            <fb-form action="user.assign-role" refresh="user-spaces" done="{{ t('The role is given.') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="userId" value="{{ user.id }}" data-type="number">
                    {{ ui.select({label: t('Role'), name: 'role', id: 'user-space-role', options: roles|map(role => {value: role.name, label: role.title})}) }}
                    {{ ui.select({label: t('Space'), name: 'scope', id: 'user-space-scope', options: spaces}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Give the role'), type: 'submit', variant: 'outline'}) }}</div>
                </form>
            </fb-form>
        </div>
        {% endif %}
    </section>
    {% endif %}

    {% if can('user.set-password') and not service %}
    <section class="fb-card" aria-labelledby="fb-set-password-title">
        <div class="fb-card__header"><h2 class="fb-heading-4" id="fb-set-password-title">{{ t('New password') }}</h2></div>
        <div class="fb-card__body">
            <fb-form action="user.set-password" reset done="{{ t('The password is set. The user is signed out everywhere.') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="id" value="{{ user.id }}" data-type="number">
                    <div class="fb-stack fb-stack--sm">
                        {{ ui.field({label: t('New password'), name: 'password', type: 'password', required: true, autocomplete: 'new-password', hint: t('At least 10 characters. Pass it on in person or by phone, not by email.')}) }}
                        <div>{{ ui.button({label: t('Make a password'), variant: 'ghost', small: true, attrs: {'data-fb-generate': 'field-password'}}) }}</div>
                    </div>
                    <div class="fb-form__actions">{{ ui.button({label: t('Set the password'), variant: 'outline', type: 'submit'}) }}</div>
                </form>
            </fb-form>
        </div>
    </section>
    {% endif %}

    {% if can('user.delete') and not yourself %}
    <section class="fb-card" aria-labelledby="fb-delete-title">
        <div class="fb-card__header">
            <div class="fb-stack fb-stack--sm">
                <h2 class="fb-heading-4" id="fb-delete-title">{{ t('Delete the user') }}</h2>
                <p class="fb-muted">{{ t('The user is signed out and can no longer sign in. What they did stays.') }}</p>
            </div>
            {{ ui.button({label: t('Delete the user'), variant: 'danger', attrs: {commandfor: 'fb-delete-user', command: 'show-modal'}}) }}
        </div>
    </section>

    <dialog class="fb-dialog" id="fb-delete-user" aria-labelledby="fb-delete-user-title">
        <fb-form action="user.delete" next="{{ path('backend.users') }}" done="{{ t('The user is deleted.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ user.id }}" data-type="number">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="fb-delete-user-title">{{ t('Delete {name}?', {name: user.name}) }}</h2>
                    <p>{{ t('The user is signed out and can no longer sign in. What they did stays.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'fb-delete-user', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Delete for good'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}
</div>
{% endblock %}
