{#- The list of roles (role.list). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('Roles') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <h1 class="fb-heading-1">{{ t('Roles') }}</h1>
            <p class="fb-muted">{{ t('A role bundles permissions. Users manage users up to their own level.') }}</p>
        </div>
        {% if can('role.create') %}{{ ui.button({label: t('New role'), href: path('backend.roles.new'), icon: 'plus'}) }}{% endif %}
    </header>

    <section class="fb-card" aria-label="{{ t('Roles') }}">
        <ul>
            {%- for role in roles %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <a class="fb-list__title fb-list__link" href="{{ path('backend.roles.show', {name: role.name}) }}">{{ role.title }}</a>
                    <span class="fb-list__meta">{{ role.name }} · {{ t(['{count} rule', '{count} rules'], {count: role.permissions|length}) }}</span>
                </span>
                {{ ui.badge('neutral', t('Level {level}', {level: role.level})) }}
            </li>
            {%- endfor %}
        </ul>
    </section>
</div>
{% endblock %}
