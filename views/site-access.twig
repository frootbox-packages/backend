{#- On the website: the password of a protected website or page, or that a preview link ended (decisions 0152 to 0154, 0358), like the sign-in. -#}
{% extends '@backend/frame.twig' %}
{% import '@backend/ui.twig' as ui %}

{% set heading = expired ? t('Preview link ended') : (reason == 'page-protected' ? t('Protected page') : t('Not public yet')) %}
{% block title %}{{ heading }}{% endblock %}

{% block body %}
<main class="fb-login">
    <div class="fb-login__inner">
        <div class="fb-login__brand">{{ ui.brand(fb) }}</div>
        <div class="fb-card fb-login__card">
            <div class="fb-login__header">
                <h1 class="fb-heading-2">{{ heading }}</h1>
                {% if fb.site %}<p class="fb-muted">{{ fb.site }}</p>{% endif %}
            </div>
            {% if expired %}
                <p>{{ t('This preview link has expired or was revoked. Ask for a new one.') }}</p>
                {{ ui.button({label: t('Go to the website'), href: '/', block: true, variant: 'outline'}) }}
            {% elseif reason == 'site-protected' or reason == 'page-protected' %}
                <p>{{ reason == 'page-protected' ? t('This page needs a password.') : t('Enter the password you got to see the website.') }}</p>
                {% if error %}{{ ui.alert({tone: 'danger', text: error}) }}{% endif %}
                <form class="fb-stack" method="post">
                    {{ ui.field({label: t('Password'), name: field, id: field, type: 'password', autocomplete: 'current-password', required: true, autofocus: true}) }}
                    {{ ui.button({label: t('Continue'), type: 'submit', block: true}) }}
                </form>
            {% else %}
                <p>{{ t('This website is not public yet. Only signed-in users and holders of a preview link see it.') }}</p>
            {% endif %}
        </div>
        {% if not expired %}<p class="fb-login__back"><a href="{{ login }}">{{ t('Sign in to edit') }}</a></p>{% endif %}
    </div>
</main>
{% endblock %}
