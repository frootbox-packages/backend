{#- Every building block in all variants, for one mode of the design page. -#}
{% import '@backend/ui.twig' as ui %}
{% set id = 'design-' ~ mode %}

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Buttons') }}</p>
    <div class="fb-cluster">
        {{ ui.button({label: t('Publish')}) }}
        {{ ui.button({label: t('Edit on the website'), variant: 'tonal', icon: 'pencil'}) }}
        {{ ui.button({label: t('Preview'), variant: 'outline'}) }}
        {{ ui.button({label: t('Cancel'), variant: 'ghost'}) }}
        {{ ui.button({label: t('Delete'), variant: 'danger'}) }}
        {{ ui.button({label: t('Delete for good'), variant: 'danger-solid'}) }}
    </div>
    <div class="fb-cluster">
        {{ ui.button({label: t('New page'), icon: 'plus', variant: 'outline', small: true}) }}
        {{ ui.button({label: t('Edit'), icon: 'pencil', variant: 'ghost', icon_only: true}) }}
        {{ ui.button({label: t('Publish'), disabled: true}) }}
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Fields') }}</p>
    {{ ui.field({label: t('Title'), name: 'title', id: id ~ '-title', value: 'Über uns', hint: t('Shown in the browser tab and in search results.')}) }}
    {{ ui.field({label: t('Address'), name: 'slug', id: id ~ '-slug', value: 'ueber-uns', prefix: 'bohnenglueck.de/'}) }}
    {{ ui.field({label: t('Address'), name: 'slug', id: id ~ '-slug-error', value: 'cms', prefix: 'bohnenglueck.de/', error: t('This address is reserved. Choose another one.')}) }}
    {{ ui.field({label: t('Description'), name: 'description', id: id ~ '-description', optional: true, multiline: true}) }}
    {{ ui.field({label: t('Email'), name: 'email', id: id ~ '-email', value: 'jan@bohnenglueck.de', disabled: true}) }}
    {{ ui.select({label: t('Layout'), name: 'layout', id: id ~ '-layout', value: 'page', options: [{value: 'one-page', label: 'OnePage'}, {value: 'page', label: 'Page'}]}) }}
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Rich text and image') }}</p>
    {{ ui.richtext({label: t('Text'), name: 'text', id: id ~ '-text', value: {type: 'doc', content: [{type: 'paragraph', content: [{type: 'text', text: 'Frisch geröstet, '}, {type: 'text', marks: [{type: 'bold'}], text: 'jeden Dienstag'}, {type: 'text', text: '.'}]}]}}) }}
    {{ ui.image({label: t('Image'), name: 'image', id: id ~ '-image', optional: true}) }}
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Choices') }}</p>
    {{ ui.check({label: t('Show in the main menu'), name: 'menu', id: id ~ '-menu', checked: true}) }}
    {{ ui.check({label: t('Open in a new window'), name: 'window', id: id ~ '-window', hint: t('Only for links to other websites.')}) }}
    <div class="fb-stack fb-stack--sm" role="radiogroup" aria-label="{{ t('Publish') }}">
        {{ ui.choice({title: t('Publish now'), text: t('Visitors see the page at once.'), name: id ~ '-when', value: 'now', checked: true}) }}
        {{ ui.choice({title: t('Keep as a draft'), text: t('Only you and your team see it.'), name: id ~ '-when', value: 'draft'}) }}
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Form') }}</p>
    <div class="fb-alert fb-form__summary" data-tone="danger" role="alert">
        {{ icon('alert', 'fb-icon fb-icon--small') }}
        <div>
            <p class="fb-alert__title">{{ t('Check the marked fields.') }}</p>
            <ul class="fb-form__errors"><li><a href="#{{ id }}-name">{{ t('Name') }}: {{ t('is required.') }}</a></li></ul>
        </div>
    </div>
    {{ ui.field({label: t('Name'), name: 'name', id: id ~ '-name', error: t('is required.')}) }}
    <fieldset class="fb-fieldset">
        <legend class="fb-fieldset__legend">{{ t('Roles') }}</legend>
        {{ ui.check({label: 'Administrator', name: 'roles[]', id: id ~ '-role-admin', value: 'admin', hint: 'admin'}) }}
        {{ ui.check({label: 'Editor', name: 'roles[]', id: id ~ '-role-editor', value: 'editor', hint: 'editor', checked: true}) }}
    </fieldset>
    {{ ui.field({label: t('Permissions'), name: 'permissions', id: id ~ '-permissions', multiline: true, value: "page.*\n-page.delete", attrs: {'data-type': 'lines', rows: 3}}) }}
    <div class="fb-form__actions">
        {{ ui.button({label: t('Save'), type: 'button'}) }}
        {{ ui.button({label: t('Cancel'), variant: 'ghost'}) }}
    </div>
    <code class="fb-secret">fbx_4f1c2a9e7b3d5f80c6a1e2d4b9f7c3a5</code>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Saving') }}</p>
    {{ ui.field({label: t('Title'), name: 'title', id: id ~ '-saved', value: 'Über uns'}) }}
    <div class="fb-form__actions">
        {{ ui.button({label: t('Save'), type: 'button', saves: true}) }}<span class="fb-form__status" role="status"></span>
        <p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p>
    </div>
    {{ ui.field({label: t('Title'), name: 'title', id: id ~ '-changed', value: 'Über uns und mehr'}) }}
    <div class="fb-form__actions">
        {{ ui.button({label: t('Save'), type: 'button', variant: 'primary', saves: true}) }}<span class="fb-form__status" role="status">{{ t('Not saved') }}</span>
        <p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p>
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Status') }}</p>
    <div class="fb-cluster">
        {{ ui.status('published') }}
        {{ ui.status('draft') }}
        {{ ui.status('changed') }}
        {{ ui.status('scheduled') }}
        {{ ui.badge('danger', t('Error')) }}
        {{ ui.badge('neutral', '12') }}
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Messages') }}</p>
    {{ ui.alert({tone: 'info', text: t('The page has a draft with changes.'), live: 'none'}) }}
    {{ ui.alert({tone: 'success', text: t('The page is published.'), live: 'none'}) }}
    {{ ui.alert({tone: 'success', text: t('The pages are published.'), live: 'none', action: ui.button({label: t('Undo'), variant: 'outline', small: true})}) }}
    {{ ui.alert({tone: 'warning', title: t('Not translated yet'), text: t('Visitors see the German text.'), live: 'none'}) }}
    {{ ui.alert({tone: 'danger', text: t('The email or the password is wrong.'), live: 'none'}) }}
    {{ ui.toast(t('Saved'), true) }}
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('List in a card') }}</p>
    <section class="fb-card">
        <div class="fb-card__header"><h3 class="fb-heading-4">{{ t('Waiting to be published') }}</h3>{{ ui.badge('neutral', '2') }}</div>
        <ul>
            <li class="fb-list__item"><span class="fb-list__main"><a class="fb-list__title fb-list__link" href="#">Kaffee</a><span class="fb-list__meta">/kaffee</span></span>{{ ui.status('changed') }}{{ ui.button({label: t('Open'), variant: 'outline', small: true}) }}</li>
            <li class="fb-list__item"><span class="fb-list__main"><span class="fb-list__title">Rösterei</span><span class="fb-list__meta">/roesterei</span></span>{{ ui.status('draft') }}{{ ui.button({label: t('Open'), variant: 'outline', small: true}) }}</li>
        </ul>
        <div class="fb-card__footer">{{ ui.button({label: t('Publish all')}) }}</div>
    </section>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Figures and charts') }}</p>
    {{ ui.figures([
        {label: t('Visits'), value: ui.number(1284), note: t('{change} compared to the period before', {change: '+12 %'})},
        {label: t('Page views'), value: ui.number(3907), note: t('{change} compared to the period before', {change: '−3 %'})},
    ]) }}
    <section class="fb-card fb-card--padded">
        {%- set days = [] -%}
        {%- for value in [32, 41, 38, 45, 29, 18, 22, 47, 52, 49, 55, 36, 24, 30] -%}
            {%- set days = days|merge([{label: t('Day {n}', {n: loop.index}), value: value}]) -%}
        {%- endfor -%}
        {{ ui.chart({label: t('Visits per day'), items: days}) }}
    </section>
    <section class="fb-card">
        <div class="fb-card__header"><h3 class="fb-heading-4">{{ t('Most visited pages') }}</h3></div>
        <ul>
            <li class="fb-list__item"><span class="fb-list__main"><span class="fb-list__title">Start</span><span class="fb-list__meta">/</span></span>{{ ui.share(1412, 1412) }}</li>
            <li class="fb-list__item"><span class="fb-list__main"><span class="fb-list__title">Kaffee</span><span class="fb-list__meta">/kaffee</span></span>{{ ui.share(806, 1412) }}</li>
            <li class="fb-list__item"><span class="fb-list__main"><span class="fb-list__title">Röstkurs</span><span class="fb-list__meta">/termine/roestkurs</span></span>{{ ui.share(97, 1412) }}</li>
        </ul>
    </section>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Disclosure') }}</p>
    <details class="fb-card fb-disclosure" open>
        <summary class="fb-disclosure__summary">{{ t('All permissions') }}</summary>
        <ul class="fb-disclosure__body">
            <li class="fb-list__item"><span class="fb-list__main"><code class="fb-list__title">page.create</code><span class="fb-list__meta">Creates a page</span></span></li>
        </ul>
    </details>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Tabs') }}</p>
    {{ ui.tabs(t('Languages'), [{label: 'Deutsch', href: '#', current: true}, {label: 'English', href: '#'}, {label: t('Versions'), href: '#'}]) }}
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Dialog') }}</p>
    <div class="fb-dialog fb-dialog--static" role="dialog" aria-labelledby="{{ id }}-dialog-title" aria-modal="false">
        <div class="fb-dialog__body">
            <h3 class="fb-dialog__title" id="{{ id }}-dialog-title">{{ t('Discard the draft?') }}</h3>
            <p class="fb-muted">{{ t('Your changes to this page are lost. The published version stays.') }}</p>
        </div>
        <div class="fb-dialog__actions">
            {{ ui.button({label: t('Keep the draft'), variant: 'outline'}) }}
            {{ ui.button({label: t('Discard'), variant: 'danger-solid'}) }}
        </div>
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Search') }}</p>
    <fb-search static src="#" query="kaffee" labels="{{ {search: t('Search'), placeholder: t('Search pages, media, users …'), close: t('Close'), found: t('{count} hits'), all: t('Show all hits')}|json_encode }}" groups="{{ [
        {title: t('Go to'), items: [{title: t('New page'), url: '#', excerpt: '', meta: ''}]},
        {title: t('Pages'), items: [
            {title: 'Kaffeesorten', url: '#', excerpt: 'Frisch geröstet in der Rösterei am Hafen.', meta: 'DE · EN'},
            {title: 'Über uns', url: '#', excerpt: 'Wir lieben Kaffee seit 1987.', meta: 'DE'},
        ]},
    ]|json_encode }}"></fb-search>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Help') }}</p>
    <div class="fb-stack">
        <div class="fb-main__bar">{{ ui.help({id: 'frootbox/backend/pages', title: t('Pages'), url: path('backend.help.show', {id: 'frootbox/backend/pages'})}, path('backend.help')) }}</div>
        <div class="fb-prose">
            <p><strong>{{ t('Sitemap') }}</strong>: {{ t('all pages as a tree.') }}</p>
            <h2 id="design-move">{{ t('Move a page') }}</h2>
            <ul><li>{{ t('Drag it in the sitemap.') }}</li><li>{{ t('Or press Alt and an arrow key.') }}</li></ul>
            <blockquote><p>{{ t('Old addresses redirect to the new ones by themselves.') }}</p></blockquote>
        </div>
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Empty state') }}</p>
    {{ ui.empty({icon: 'image', title: t('No media yet'), text: t('Upload images and files to use them on your pages.'), action: {label: t('Upload'), icon: 'plus'}}) }}
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Tree and details') }}</p>
    <div class="fb-split">
        <section class="fb-card fb-split__side" aria-labelledby="{{ id }}-tree-title">
            <div class="fb-card__header fb-card__header--tight"><h3 class="fb-heading-4" id="{{ id }}-tree-title">{{ t('Sitemap') }}</h3></div>
            <div class="fb-tree-filter">
                <label class="fb-visually-hidden" for="{{ id }}-tree-filter">{{ t('Find a page') }}</label>
                <span class="fb-tree-filter__icon" aria-hidden="true">{{ icon('search', 'fb-icon fb-icon--small') }}</span>
                <input class="fb-input fb-tree-filter__input" id="{{ id }}-tree-filter" type="search" placeholder="{{ t('Find by title or address') }}" autocomplete="off">
            </div>
            <fb-tree>
                <ul class="fb-tree fb-tree--compact" aria-labelledby="{{ id }}-tree-title">
                    <li class="fb-tree__item" data-id="{{ id }}-start" data-title="Bohnenglück" data-fixed>
                        <div class="fb-tree__row" data-depth="0">
                            <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                            <button class="fb-tree__toggle" type="button" aria-expanded="true" aria-controls="{{ id }}-start-group" aria-label="{{ t('Subpages of {page}', {page: 'Bohnenglück'}) }}" tabindex="-1">{{ icon('chevron-down', 'fb-icon fb-icon--small') }}</button>
                            <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                            <a class="fb-tree__link" href="#"><span class="fb-tree__title">Bohnenglück</span></a>
                        </div>
                        <ul class="fb-tree__group" id="{{ id }}-start-group">
                            <li class="fb-tree__item" data-id="{{ id }}-care" data-title="Medizin und Pflege">
                                <div class="fb-tree__row" data-depth="1">
                                    <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                    <button class="fb-tree__toggle" type="button" aria-expanded="true" aria-controls="{{ id }}-care-group" aria-label="{{ t('Subpages of {page}', {page: 'Medizin und Pflege'}) }}" tabindex="-1">{{ icon('chevron-down', 'fb-icon fb-icon--small') }}</button>
                                    <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                                    <a class="fb-tree__link" href="#"><span class="fb-tree__title">Medizin und Pflege</span></a>
                                </div>
                                <ul class="fb-tree__group" id="{{ id }}-care-group">
                                    <li class="fb-tree__item" data-id="{{ id }}-clinics" data-title="Kliniken">
                                        <div class="fb-tree__row" data-depth="2">
                                            <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                            <button class="fb-tree__toggle" type="button" aria-expanded="true" aria-controls="{{ id }}-clinics-group" aria-label="{{ t('Subpages of {page}', {page: 'Kliniken'}) }}" tabindex="-1">{{ icon('chevron-down', 'fb-icon fb-icon--small') }}</button>
                                            <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                                            <a class="fb-tree__link" href="#"><span class="fb-tree__title">Kliniken</span></a>
                                        </div>
                                        <ul class="fb-tree__group" id="{{ id }}-clinics-group">
                                            <li class="fb-tree__item" data-id="{{ id }}-psych" data-title="Psychiatrie und Psychotherapie">
                                                <div class="fb-tree__row" data-depth="3">
                                                    <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                                    <button class="fb-tree__toggle" type="button" aria-expanded="true" aria-controls="{{ id }}-psych-group" aria-label="{{ t('Subpages of {page}', {page: 'Psychiatrie und Psychotherapie'}) }}" tabindex="-1">{{ icon('chevron-down', 'fb-icon fb-icon--small') }}</button>
                                                    <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                                                    <a class="fb-tree__link" href="#"><span class="fb-tree__title">Psychiatrie und Psychotherapie</span></a>
                                                </div>
                                                <ul class="fb-tree__group" id="{{ id }}-psych-group">
                                                    <li class="fb-tree__item" data-id="{{ id }}-station" data-title="Akut- und Krisenintervention Gerontopsychiatrie – Station 57">
                                                        <div class="fb-tree__row" data-depth="4">
                                                            <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                                            <span class="fb-tree__toggle" aria-hidden="true"></span>
                                                            <span class="fb-tree__dot" data-status="changed" aria-hidden="true"></span>
                                                            <a class="fb-tree__link" href="#" aria-current="page"><span class="fb-tree__title">Akut- und Krisenintervention Gerontopsychiatrie – Station 57</span></a>
                                                            <span class="fb-tree__flag" data-status="changed" aria-hidden="true">{{ t('Pending changes') }}</span>
                                                        </div>
                                                    </li>
                                                    <li class="fb-tree__item" data-id="{{ id }}-portal" data-title="Patientenportal">
                                                        <div class="fb-tree__row" data-depth="4">
                                                            <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                                            <span class="fb-tree__toggle" aria-hidden="true"></span>
                                                            <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                                                            <a class="fb-tree__link" href="#"><span class="fb-tree__title">Patientenportal</span></a>
                                                            <span class="fb-tree__flag" data-status="danger" aria-hidden="true">{{ icon('lock', 'fb-icon fb-icon--small') }}{{ t('Locked') }}</span>
                                                        </div>
                                                    </li>
                                                    <li class="fb-tree__item" data-id="{{ id }}-day" data-title="Tagesklinik">
                                                        <div class="fb-tree__row" data-depth="4">
                                                            <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                                            <span class="fb-tree__toggle" aria-hidden="true"></span>
                                                            <span class="fb-tree__dot" data-status="draft" aria-hidden="true"></span>
                                                            <a class="fb-tree__link" href="#"><span class="fb-tree__title">Tagesklinik</span></a>
                                                            <span class="fb-tree__flag" data-status="draft" aria-hidden="true">{{ t('Draft') }}</span>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </li>
                                            <li class="fb-tree__item" data-id="{{ id }}-radio" data-title="Radiologie">
                                                <div class="fb-tree__row" data-depth="3">
                                                    <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                                    <span class="fb-tree__toggle" aria-hidden="true"></span>
                                                    <span class="fb-tree__dot" data-status="scheduled" aria-hidden="true"></span>
                                                    <a class="fb-tree__link" href="#"><span class="fb-tree__title">Radiologie</span></a>
                                                    <span class="fb-tree__flag" data-status="scheduled" aria-hidden="true">{{ t('Scheduled') }}</span>
                                                </div>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                            <li class="fb-tree__item" data-id="{{ id }}-jobs" data-title="Jobs und Karriere" data-collapsed>
                                <div class="fb-tree__row" data-depth="1">
                                    <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                    <button class="fb-tree__toggle" type="button" aria-expanded="false" aria-controls="{{ id }}-jobs-group" aria-label="{{ t('Subpages of {page}', {page: 'Jobs und Karriere'}) }}" tabindex="-1">{{ icon('chevron-down', 'fb-icon fb-icon--small') }}</button>
                                    <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                                    <a class="fb-tree__link" href="#"><span class="fb-tree__title">Jobs und Karriere</span></a>
                                </div>
                                <ul class="fb-tree__group" id="{{ id }}-jobs-group">
                                    <li class="fb-tree__item" data-id="{{ id }}-offers" data-title="Stellenangebote">
                                        <div class="fb-tree__row" data-depth="2">
                                            <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                            <span class="fb-tree__toggle" aria-hidden="true"></span>
                                            <span class="fb-tree__dot" data-status="published" aria-hidden="true"></span>
                                            <a class="fb-tree__link" href="#"><span class="fb-tree__title">Stellenangebote</span></a>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                            <li class="fb-tree__item" data-id="{{ id }}-imprint" data-title="Impressum" data-fixed data-leaf data-outside>
                                <div class="fb-tree__row" data-depth="1">
                                    <span class="fb-tree__handle" aria-hidden="true">{{ icon('grip', 'fb-icon fb-icon--small') }}</span>
                                    <span class="fb-tree__toggle" aria-hidden="true"></span>
                                    <span class="fb-tree__link"><span class="fb-tree__title">Impressum</span><span class="fb-tree__meta">{{ t('Outside your pages') }}</span></span>
                                </div>
                            </li>
                        </ul>
                    </li>
                </ul>
            </fb-tree>
        </section>
        <section class="fb-card fb-split__main" aria-labelledby="{{ id }}-detail-title">
            <div class="fb-card__header"><h3 class="fb-heading-4" id="{{ id }}-detail-title">Über uns</h3>{{ ui.status('changed') }}</div>
            <div class="fb-card__body">
                <div class="fb-missing">
                    <p class="fb-missing__title">{{ t('No version in {language} yet', {language: 'English'}) }}</p>
                    <p class="fb-muted">{{ t('Visitors in this language see the page in another language.') }}</p>
                    {{ ui.button({label: t('Add the version in {language}', {language: 'English'}), variant: 'outline', icon: 'plus'}) }}
                </div>
            </div>
            <section class="fb-section">
                <h4 class="fb-heading-4">{{ t('Times') }}</h4>
                {% set parts = t('Will be published on {time} by itself.')|split('{time}') %}
                <p>{{ parts[0] }}{{ ui.time(date('2026-11-01T18:00:00+01:00')) }}{{ parts[1] ?? '' }}</p>
            </section>
        </section>
    </div>
</div>

<div class="fb-design-sample">
    <p class="fb-design-sample__title">{{ t('Media') }}</p>
    {%- set picture = 'data:image/svg+xml,' ~ ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 100"><rect width="160" height="100" fill="#8a4b2a"/><rect x="96" y="20" width="32" height="30" fill="#f5efe6"/></svg>'|url_encode) %}
    {%- set square = 'data:image/svg+xml,' ~ ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="#2b6a4b"/><circle cx="50" cy="50" r="22" fill="#f5efe6"/></svg>'|url_encode) %}
    <fb-upload label="{{ t('Drop images here to upload them') }}" disabled>
        <ul class="fb-media-grid">
