{#- The sign-in at <backend.path>/login. -#}
{% extends '@backend/frame.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('Sign in') }}{% endblock %}

{% block body %}
<main class="fb-login">
    <div class="fb-login__inner">
        <div class="fb-login__brand">{{ ui.brand(fb) }}</div>
        <div class="fb-card fb-login__card">
            <div class="fb-login__header">
                <h1 class="fb-heading-2">{{ t('Sign in') }}</h1>
                {% if fb.site %}<p class="fb-muted">{{ fb.site }}</p>{% endif %}
            </div>
            {% if error %}{{ ui.alert({tone: 'danger', text: error}) }}{% endif %}
            {% if signed_out %}{{ ui.alert({tone: 'info', text: t('You are signed out.')}) }}{% endif %}
            {% if email_changed ?? false %}{{ ui.alert({tone: 'success', text: t('Your email is changed. Sign in with it from now on.')}) }}{% endif %}
            {%- set chosen = (providers ?? [])|filter(p => p.key == (provider ?? null))|first %}
            {% if chosen %}{{ ui.alert({tone: 'info', text: t('Your session has ended. Sign in again with {provider}.', {provider: chosen.title})}) }}{% endif %}
            {%- if (providers ?? []) is not empty %}
            {#- The password stays: the website never depends on a provider (decision 0322). -#}
            <div class="fb-stack">
                {%- for p in providers %}
                {{ ui.button({label: t('Sign in with {provider}', {provider: p.title}), href: path('backend.oidc.start', {provider: p.key}|merge(next ? {next: next} : {})), block: true, icon: 'external'}) }}
                {%- endfor %}
                <p class="fb-muted">{{ t('Or with your email and password:') }}</p>
            </div>
            {%- endif %}
            <form class="fb-stack" method="post" action="{{ path('backend.login') }}">
                {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}
                {{ ui.field({label: t('Email'), name: 'email', type: 'email', value: email, autocomplete: 'username', required: true, autofocus: email is empty}) }}
                {{ ui.field({label: t('Password'), name: 'password', type: 'password', autocomplete: 'current-password', required: true, autofocus: email is not empty}) }}
                {{ ui.check({label: t('Stay signed in'), name: 'remember', checked: remember, hint: t('Only on a device of your own.')}) }}
                {{ ui.button({label: t('Sign in'), type: 'submit', block: true, variant: (providers ?? []) is empty ? 'primary' : 'outline'}) }}
            </form>
            {%- if password_reset ?? false %}
            <p class="fb-login__forgot"><a href="{{ path('backend.password') }}">{{ t('Forgot your password?') }}</a></p>
            {%- endif %}
        </div>
        <p class="fb-login__back"><a href="/">{{ t('Go to the website') }}</a></p>
    </div>
</main>
{% endblock %}
