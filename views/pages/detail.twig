{#- The details of a page: status, publishing, title and address by language, times, visibility, versions and the latest changes (decisions 0116, 0117 and 0174). -#}
{% import '@backend/ui.twig' as ui %}
{% set details = page.details %}
{% set row = page.row %}
{% set has_draft = details.draft is not null %}
{% set published = details.published is not null %}
{% set refresh = 'page-tree page-detail' %}
{% set self = path('backend.pages.show', {id: page.id}) %}
{% if standalone ?? false %}<title>{{ row.title }} · {{ t('Pages') }} · {{ fb.brand }}</title>{% endif %}
<section class="fb-card fb-split__main" id="page-detail" aria-labelledby="page-detail-title">
    <div class="fb-card__header">
        <div class="fb-stack fb-stack--sm">
            <h2 class="fb-heading-2" id="page-detail-title" tabindex="-1" data-fb-focus>{{ row.title }}</h2>
            <p class="fb-muted">{{ row.path }} · {{ t('Layout {layout}', {layout: page.layout}) }}</p>
        </div>
        <div class="fb-cluster">
            {% if row.locked %}{{ ui.badge('danger', t('Locked')) }}{% endif %}
            {% if row.protected %}{{ ui.badge('info', t('Password')) }}{% endif %}
            {{ ui.status(row.status) }}
        </div>
    </div>
    <div class="fb-card__body fb-stack">
        {% for planned in [{at: details.publishAt, text: t('Will be published on {time} by itself.')}, {at: details.unpublishAt, text: t('Goes offline on {time} by itself.')}] %}
            {% if planned.at %}
            {% set parts = planned.text|split('{time}') %}
            {% set text %}{{ parts[0] }}{{ ui.time(planned.at) }}{{ parts[1] ?? '' }}{% endset %}
            {{ ui.alert({tone: 'info', text: text, live: 'none'}) }}
            {% endif %}
        {% endfor %}

        <div class="fb-cluster">
            {% if page.edit %}
            <form method="post" action="{{ path('backend.edit-mode') }}">
                <input type="hidden" name="_csrf" value="{{ fb.csrf }}">
                <input type="hidden" name="on" value="1">
                <input type="hidden" name="next" value="{{ page.edit }}">
                {{ ui.button({label: t('Edit on the website'), type: 'submit', variant: 'tonal', icon: 'pencil'}) }}
            </form>
            {% endif %}
            {% if page.url %}{{ ui.button({label: t('View on the website'), href: page.url, variant: 'outline', icon: 'external', attrs: {target: '_blank', rel: 'noopener'}}) }}{% endif %}
            {% if has_draft and can('page.publish', {ids: page.publish}) %}
                {% if page.offline_parents is empty %}
                <fb-form action="page.publish" refresh="{{ refresh }}" done="{{ t('The page is published.') }}">
                    <form novalidate>
                        <input type="hidden" name="ids[]" value="{{ page.id }}">
                        {{ ui.button({label: t('Publish'), type: 'submit'}) }}
                    </form>
                </fb-form>
                {% else %}
                {{ ui.button({label: t('Publish'), attrs: {commandfor: 'page-publish', command: 'show-modal'}}) }}
                {% endif %}
            {% endif %}
            {% if has_draft and can('page.discard', {id: page.id}) %}
                {{ ui.button({label: t('Discard the draft'), variant: 'danger', attrs: {commandfor: 'page-discard', command: 'show-modal'}}) }}
            {% endif %}
        </div>
    </div>

    {{ ui.tabs(t('Languages'), page.languages|map(language => {
        label: language.title,
        href: self ~ '?language=' ~ language.code,
        current: language.code == page.language.code,
        attrs: {'hx-get': self ~ '?language=' ~ language.code, 'hx-target': '#page-detail', 'hx-select': '#page-detail', 'hx-swap': 'outerHTML', 'hx-push-url': 'true', lang: language.code},
    })) }}

    <div class="fb-card__body fb-stack">
        {% set translation = page.translation %}
        {% set editable = can('page.update', {id: page.id}) %}
        {% if translation %}
        <fb-form action="page.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
            <form class="fb-stack" novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                {{ ui.field({label: t('Title'), name: 'translations.' ~ page.language.code ~ '.title', id: 'page-title', value: translation.title, required: true, disabled: not editable, attrs: {lang: page.language.code, dir: page.language.direction.value}}) }}
                {% if row.start %}
                    {{ ui.field({label: t('Address'), name: '', id: 'page-slug', value: page.prefix, disabled: true, hint: t('The start page has no address of its own.')}) }}
                {% else %}
                    {{ ui.field({label: t('Address'), name: 'translations.' ~ page.language.code ~ '.slug', id: 'page-slug', value: translation.slug, prefix: page.prefix, required: true, disabled: not editable, attrs: {dir: 'ltr'}, hint: t('If the address changes, the old one redirects to the new one.')}) }}
                {% endif %}
                {{ ui.field({label: t('Title for search engines'), name: 'translations.' ~ page.language.code ~ '.seoTitle', id: 'page-seo-title', value: translation.seoTitle, optional: true, disabled: not editable, placeholder: page.default_title, hint: t('Replaces the whole title in search results and when sharing, the name of the website is not added. About 60 characters fit.'), attrs: {lang: page.language.code, dir: page.language.direction.value, maxlength: 120}}) }}
                {{ ui.field({label: t('Description for search engines'), name: 'translations.' ~ page.language.code ~ '.description', id: 'page-description', value: translation.description, multiline: true, optional: true, disabled: not editable, hint: t('Search engines often show it below the title. 50 to 160 characters fit best.'), attrs: {lang: page.language.code, dir: page.language.direction.value, rows: 3, maxlength: 300}}) }}
                {% if editable %}
                <div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}<p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p></div>
                {% endif %}
            </form>
        </fb-form>
        {% else %}
        <div class="fb-missing">
            <p class="fb-missing__title">{{ t('No version in {language} yet', {language: page.language.title}) }}</p>
            <p class="fb-muted">
                {%- if page.url -%}
                    {{ t('Visitors in this language see the page in another language.') }}
                {%- else -%}
                    {{ t('Visitors in this language do not find the page.') }}
                {%- endif -%}
            </p>
            {% if editable %}
            {% set source = details.draft.translations[page.default.code] ?? details.published.translations[page.default.code] ?? null %}
            <fb-form action="page.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                <form novalidate>
                    <input type="hidden" name="id" value="{{ page.id }}">
                    <input type="hidden" name="translations.{{ page.language.code }}.title" value="{{ source.title ?? row.title }}">
                    {{ ui.button({label: t('Add the version in {language}', {language: page.language.title}), type: 'submit', variant: 'tonal', icon: 'plus'}) }}
                </form>
            </fb-form>
            {% endif %}
        </div>
        {% endif %}
    </div>

    {% if can('page.schedule', {id: page.id}) %}
    <section class="fb-section" aria-labelledby="page-schedule-title">
        <h3 class="fb-heading-4" id="page-schedule-title">{{ t('Times') }}</h3>
        <fb-form action="page.schedule" refresh="{{ refresh }}" done="{{ t('Saved') }}">
            <form class="fb-stack" novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                {{ ui.field({label: t('Publish on'), name: 'publishAt', id: 'page-publish-at', type: 'datetime-local', optional: true, value: details.publishAt ? details.publishAt|date('Y-m-d\\TH:i') : '', disabled: not has_draft, hint: has_draft ? t('The draft goes online by itself.') : t('Only for a draft.'), attrs: {'data-type': 'datetime', 'data-value': details.publishAt ? details.publishAt|date('c') : null}}) }}
                {{ ui.field({label: t('Take offline on'), name: 'unpublishAt', id: 'page-unpublish-at', type: 'datetime-local', optional: true, value: details.unpublishAt ? details.unpublishAt|date('Y-m-d\\TH:i') : '', disabled: not published, hint: published ? t('The page and its subpages go offline by themselves.') : t('Only for a published page.'), attrs: {'data-type': 'datetime', 'data-value': details.unpublishAt ? details.unpublishAt|date('c') : null}}) }}
                {% if has_draft or published %}<div class="fb-form__actions">{{ ui.button({label: t('Save the times'), type: 'submit', saves: true}) }}</div>{% endif %}
            </form>
        </fb-form>
    </section>
    {% endif %}

    {% set shows = page.plugin %}
    {% if shows is not null %}
    {% set current = shows.current %}
    <section class="fb-section" aria-labelledby="page-plugin-title">
        <h3 class="fb-heading-4" id="page-plugin-title">{{ t('This page shows') }}</h3>
        {% if not shows.slot and current is null %}
        <p class="fb-muted">{{ t('The layout {layout} has no place for a module. Choose another layout to show news, events or jobs here.', {layout: page.layout}) }}</p>
        {% else %}
        <fb-form action="plugin.assign" refresh="{{ refresh }}" done="{{ t('Saved') }}">
            <form class="fb-stack" novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                {{ ui.select({label: t('Content from a module'), name: 'type', id: 'page-plugin-type', value: current.type ?? '', options: [{value: '', label: t('Nothing')}]|merge(shows.plugins|map(plugin => {value: plugin.type, label: plugin.label})), hint: t('The page lists the entries of the module, each entry gets its own address below it.'), attrs: {'data-empty': 'null'}}) }}
                {% for plugin in shows.plugins %}
                {% set mine = current is not null and current.type == plugin.type %}
                <div class="fb-stack" data-fb-when="type={{ plugin.type }}"{% if not mine %} hidden{% endif %}>
                    {% if plugin.several %}
                    {% set options = plugin.spaces|map(space => {value: space.id, label: space.other ? t('{space} (shown on {page})', {space: space.title, page: space.other}) : space.title, attrs: {disabled: space.other is not null}}) %}
                    {{ ui.select({label: t('Space'), name: 'space', id: 'page-plugin-space-' ~ loop.index, value: mine ? current.space : (plugin.spaces|filter(space => space.other is null)|first).id ?? 'default', options: options, disabled: not mine, hint: t('Each space has its own entries and at most one page.')}) }}
                    {{ ui.field({label: t('Or a new space'), name: 'newSpace', id: 'page-plugin-new-' ~ loop.index, optional: true, disabled: not mine, hint: t('The name of a new space for this page, e.g. Ausbildung. Editors see it instead of the name of the module.'), attrs: {'data-empty': 'null', maxlength: 100}}) }}
                    {% endif %}
                    {% if plugin.details == 'optional' %}
                    {{ ui.check({label: t('Pages of their own for the entries'), name: 'details', id: 'page-plugin-details-' ~ loop.index, checked: mine ? current.details : true, disabled: not mine, hint: t('Without them, lists show the entries without links.')}) }}
                    {% endif %}
                    {% if plugin.categories == 'optional' %}
                    {{ ui.check({label: t('Pages of their own for the categories'), name: 'categories', id: 'page-plugin-categories-' ~ loop.index, checked: mine ? current.categories : false, disabled: not mine, hint: t('Each category gets an address below this page, e.g. for search engines. Without them, lists filter on the page itself.')}) }}
                    {% endif %}
                </div>
                {% endfor %}
                <div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}<p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p></div>
            </form>
        </fb-form>
        {% endif %}
    </section>
    {% endif %}

    {% set locked = details.locked.value %}
    {% set can_lock = published and locked == 'none' and not page.inherited.locked and can('page.lock', {id: page.id}) %}
    <section class="fb-section" aria-labelledby="page-visibility-title">
        <h3 class="fb-heading-4" id="page-visibility-title">{{ t('Visibility') }}</h3>
        <div class="fb-stack">
            {% if locked != 'none' %}
                {{ ui.alert({tone: 'warning', title: t('Locked for visitors'), text: locked == 'branch' ? t('Visitors get a notice instead of this page and its subpages.') : t('Visitors get a notice instead of this page.'), live: 'none'}) }}
                {% if can('page.unlock', {id: page.id}) %}
                <fb-form action="page.unlock" refresh="{{ refresh }}" done="{{ t('The page is unlocked.') }}">
                    <form novalidate>
                        <input type="hidden" name="id" value="{{ page.id }}">
                        {{ ui.button({label: t('Unlock'), type: 'submit', variant: 'outline'}) }}
                    </form>
                </fb-form>
                {% endif %}
            {% elseif page.inherited.locked %}
                {{ ui.alert({tone: 'warning', title: t('Locked for visitors'), text: t('The lock comes from {page} above. It can be lifted there.', {page: page.inherited.locked}), live: 'none'}) }}
            {% elseif can_lock %}
                <p class="fb-muted">{{ t('A locked page stays published, visitors get a notice instead. It works right away.') }}</p>
                <div class="fb-cluster">{{ ui.button({label: t('Lock for visitors'), variant: 'outline', icon: 'lock', attrs: {commandfor: 'page-lock', command: 'show-modal'}}) }}</div>
            {% elseif not published and can('page.lock', {id: page.id}) %}
                <p class="fb-muted">{{ t('Only a published page can be locked.') }}</p>
            {% endif %}

            {#- A password for visitors, right away and also before publishing (decision 0358). -#}
            {% set protected = details.protected.value %}
            {% if protected != 'none' %}
                {{ ui.alert({tone: 'info', title: t('Password protected'), text: (protected == 'branch' ? t('Visitors need the password for this page and its subpages. Signed-in users and preview links do not.') : t('Visitors need the password for this page. Signed-in users and preview links do not.')) ~ (details.protectedSince ? ' ' ~ t('Since {date}.', {date: details.protectedSince|date(t('Y-m-d H:i'))}) : ''), live: 'none'}) }}
            {% elseif page.inherited.protected %}
                {{ ui.alert({tone: 'info', title: t('Password protected'), text: t('The password comes from {page} above. A password of its own applies here instead.', {page: page.inherited.protected}), live: 'none'}) }}
            {% endif %}
            {#- The password is required input, a placeholder lets the targets count. -#}
            {% if can('page.protect', {id: page.id, password: '********'}) %}
            <fb-form action="page.protect" refresh="{{ refresh }}" done="{{ protected != 'none' ? t('The new password applies.') : t('The page is password protected.') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="id" value="{{ page.id }}">
                    {{ ui.field({label: protected != 'none' ? t('New password') : t('Password for visitors'), name: 'password', id: 'page-password', type: 'password', autocomplete: 'new-password', required: true, hint: protected != 'none' ? t('Browsers let in with the old password need the new one.') : t('At least 8 characters. Only visitors who know it see the page. It works right away, also before publishing.')}) }}
                    {% if page.has_children %}{{ ui.check({label: t('Also for the subpages'), name: 'branch', id: 'page-password-branch', checked: protected == 'branch'}) }}{% endif %}
                    <div class="fb-cluster">{{ ui.button({label: protected != 'none' ? t('Set new password') : t('Protect with password'), type: 'submit', variant: 'outline', icon: 'shield'}) }}</div>
                </form>
            </fb-form>
            {% endif %}
            {% if protected != 'none' and can('page.unprotect', {id: page.id}) %}
            <fb-form action="page.unprotect" refresh="{{ refresh }}" done="{{ t('The password is switched off.') }}">
                <form novalidate>
                    <input type="hidden" name="id" value="{{ page.id }}">
                    {{ ui.button({label: t('Switch password off'), type: 'submit', variant: 'outline'}) }}
                </form>
            </fb-form>
            {% endif %}

            {% set exclusions = details.draft ?? details.published %}
            {% set reach = [
                {value: 'none', label: t('Include')},
                {value: 'page', label: t('Leave out this page')},
                {value: 'branch', label: t('Leave out this page and its subpages')},
            ] %}
            <fb-form action="page.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                <form class="fb-stack" novalidate>
                    <input type="hidden" name="id" value="{{ page.id }}">
                    {{ ui.select({label: t('Search engines'), name: 'excludeFromSearchEngines', id: 'page-search-engines', options: reach, value: exclusions.excludeFromSearchEngines.value, disabled: not editable, hint: page.inherited.searchEngines ? t('Left out anyway through {page} above.', {page: page.inherited.searchEngines}) : t('Left out pages tell search engines not to list them.')}) }}
                    {{ ui.select({label: t('Search on the website'), name: 'excludeFromSiteSearch', id: 'page-site-search', options: reach, value: exclusions.excludeFromSiteSearch.value, disabled: not editable, hint: page.inherited.siteSearch ? t('Left out anyway through {page} above.', {page: page.inherited.siteSearch}) : t('Applies as soon as a search module is installed.')}) }}
                    {% if editable %}
                    <div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}<p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p></div>
                    {% endif %}
                </form>
            </fb-form>
        </div>
    </section>

    {% if page.versions is not null %}
    <section class="fb-section fb-section--flush" aria-labelledby="page-versions-title">
        <div class="fb-section__header"><h3 class="fb-heading-4" id="page-versions-title">{{ t('Versions') }}</h3></div>
        {% if page.versions is empty %}
        <p class="fb-muted">{{ t('Not published yet.') }}</p>
        {% else %}
        <ul>
            {%- for entry in page.versions %}
            {% set version = entry.version %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <span class="fb-list__title">{{ t('Version {number}', {number: version.version}) }}</span>
                    <span class="fb-list__meta">{{ ui.time(version.publishedAt) }}{% if entry.author %} · {{ entry.author }}{% endif %}</span>
                </span>
                {% if version.current %}
                    {{ ui.badge('neutral', t('Online')) }}
                {% elseif can('page.restore', {id: page.id, version: 1}) %}
                <fb-form action="page.restore" refresh="{{ refresh }}" done="{{ t('Version {number} is in the draft now.', {number: version.version}) }}">
                    <form novalidate>
                        <input type="hidden" name="id" value="{{ page.id }}">
                        <input type="hidden" name="version" value="{{ version.version }}" data-type="number">
                        {{ ui.button({label: t('Restore'), type: 'submit', variant: 'ghost', small: true, icon: 'restore', attrs: {'aria-label': t('Restore version {number}', {number: version.version})}}) }}
                    </form>
                </fb-form>
                {% endif %}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
    </section>
    {% endif %}

    {% if page.history is not null %}
    <section class="fb-section fb-section--flush" aria-labelledby="page-history-title">
        <div class="fb-section__header">
            <h3 class="fb-heading-4" id="page-history-title">{{ t('History') }}</h3>
            {% if page.history.entries is not empty %}{{ ui.button({label: t('Whole history'), href: path('backend.pages.history', {id: page.id}), variant: 'ghost', small: true, icon: 'history'}) }}{% endif %}
        </div>
        {% if page.history.entries is empty %}
        <p class="fb-muted">{{ t('No changes yet.') }}</p>
        {% else %}
        {% include '@backend/history/entries.twig' with {entries: page.history.entries, changes: false} only %}
        {% endif %}
    </section>
    {% endif %}

    {% set can_unpublish = published and can('page.unpublish', {id: page.id}) %}
    {% set can_delete = not row.start and not page.has_children and can('page.delete', {id: page.id}) %}
    {% if can_unpublish or can_delete %}
    <section class="fb-section" aria-labelledby="page-more-title">
        <h3 class="fb-heading-4" id="page-more-title">{{ t('Offline and delete') }}</h3>
        <div class="fb-cluster">
            {% if can_unpublish %}{{ ui.button({label: t('Take offline'), variant: 'outline', attrs: {commandfor: 'page-unpublish', command: 'show-modal'}}) }}{% endif %}
            {% if can_delete %}{{ ui.button({label: t('Delete the page'), variant: 'danger', attrs: {commandfor: 'page-delete', command: 'show-modal'}}) }}{% endif %}
        </div>
        {% if not row.start and page.has_children and can('page.delete', {id: page.id}) %}<p class="fb-muted">{{ t('A page with subpages cannot be deleted. Move or delete them first.') }}</p>{% endif %}
    </section>
    {% endif %}

    {% if has_draft and can('page.publish', {ids: page.publish}) and page.offline_parents is not empty %}
    <dialog class="fb-dialog" id="page-publish" aria-labelledby="page-publish-title">
        <fb-form action="page.publish" refresh="{{ refresh }}" done="{{ t('The pages are published.') }}">
            <form novalidate>
                {% for id in page.publish %}<input type="hidden" name="ids[]" value="{{ id }}">{% endfor %}
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="page-publish-title">{{ t('Publish with its parents?') }}</h2>
                    <p>{{ t('These pages above it are not online yet and are published with it: {pages}.', {pages: page.offline_parents|join(', ')}) }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'page-publish', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Publish all'), type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}

    {% if has_draft and can('page.discard', {id: page.id}) %}
    <dialog class="fb-dialog" id="page-discard" aria-labelledby="page-discard-title">
        <fb-form action="page.discard" {% if published %}refresh="{{ refresh }}"{% else %}next="{{ path('backend.pages') }}"{% endif %} done="{{ t('The draft is discarded.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="page-discard-title">{{ t('Discard the draft?') }}</h2>
                    <p>{{ published ? t('Your changes to this page are lost. The published version stays.') : t('The page was never published and is gone afterwards.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Keep the draft'), variant: 'outline', attrs: {commandfor: 'page-discard', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Discard'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}

    {% if can_unpublish %}
    <dialog class="fb-dialog" id="page-unpublish" aria-labelledby="page-unpublish-title">
        <fb-form action="page.unpublish" refresh="{{ refresh }}" done="{{ t('The page is offline.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="page-unpublish-title">{{ t('Take {title} offline?', {title: row.title}) }}</h2>
                    <p>{{ t('Visitors no longer find the page and its subpages. They stay as drafts and can be published again.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'page-unpublish', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Take offline'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}

    {% if can_lock %}
    <dialog class="fb-dialog" id="page-lock" aria-labelledby="page-lock-title">
        <fb-form action="page.lock" refresh="{{ refresh }}" done="{{ t('The page is locked.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                <div class="fb-dialog__body fb-stack">
                    <h2 class="fb-dialog__title" id="page-lock-title">{{ t('Lock {title} for visitors?', {title: row.title}) }}</h2>
                    <p>{{ t('Visitors get a notice right away that the page is not available at the moment. It stays published and keeps its addresses.') }}</p>
                    {% if page.has_children %}{{ ui.check({label: t('Also lock the subpages'), name: 'branch', id: 'page-lock-branch'}) }}{% endif %}
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'page-lock', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Lock'), type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}

    {% if can_delete %}
    <dialog class="fb-dialog" id="page-delete" aria-labelledby="page-delete-title">
        <fb-form action="page.delete" next="{{ path('backend.pages.show', {id: page.parent}) }}" done="{{ t('The page is deleted.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ page.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="page-delete-title">{{ t('Delete {title}?', {title: row.title}) }}</h2>
                    <p>{{ t('The page leaves the tree and the website. Visitors no longer find it.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'page-delete', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Delete for good'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}
</section>
