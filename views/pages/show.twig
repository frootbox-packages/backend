{#- The pages: the tree and the details of one page (decision 0116). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ page.row.title }} · {{ t('Pages') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <h1 class="fb-heading-1">{{ t('Pages') }}</h1>
        </div>
        {% if can('page.create', {layout: '', translations: [], parentId: page.id}) %}{{ ui.button({label: t('New page'), href: path('backend.pages.new') ~ '?parent=' ~ page.id, icon: 'plus'}) }}{% endif %}
    </header>

    <div class="fb-split">
        <section class="fb-card fb-split__side fb-split__side--sticky" aria-labelledby="page-tree-title">
            <div class="fb-card__header fb-card__header--tight">
                <h2 class="fb-heading-4" id="page-tree-title">{{ t('Sitemap') }}</h2>
                {% if can('page.move') %}<p class="fb-muted" id="page-tree-hint">{{ t('Drag to move, or Alt and the arrow keys.') }}</p>{% endif %}
            </div>
            <fb-tree-filter class="fb-tree-filter" for="page-tree" found="{{ t('{count} pages found') }}" one="{{ t('One page found') }}" empty="{{ t('No page found') }}">
                <label class="fb-visually-hidden" for="page-tree-filter">{{ t('Find a page') }}</label>
                <span class="fb-tree-filter__icon" aria-hidden="true">{{ icon('search', 'fb-icon fb-icon--small') }}</span>
                <input class="fb-input fb-tree-filter__input" id="page-tree-filter" type="search" placeholder="{{ t('Find by title or address') }}" autocomplete="off" spellcheck="false" aria-controls="page-tree" aria-describedby="page-tree-filter-status" aria-keyshortcuts="/">
                <p class="fb-tree-filter__status" id="page-tree-filter-status" role="status"></p>
            </fb-tree-filter>
            {% include '@backend/pages/tree.twig' %}
        </section>

        {% include '@backend/pages/detail.twig' %}
    </div>
</div>
{% endblock %}
