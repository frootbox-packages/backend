{#- A forgotten password at <backend.path>/password and /password/<token> (decision 0326). -#}
{% extends '@backend/frame.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ step == 'reset' ? t('New password') : t('Forgot your password?') }}{% endblock %}

{% block body %}
<main class="fb-login">
    <div class="fb-login__inner">
        <div class="fb-login__brand">{{ ui.brand(fb) }}</div>
        <div class="fb-card fb-login__card">
            <div class="fb-login__header">
                <h1 class="fb-heading-2">{{ step == 'reset' ? t('New password') : t('Forgot your password?') }}</h1>
                {% if fb.site %}<p class="fb-muted">{{ fb.site }}</p>{% endif %}
            </div>
            {% if error %}{{ ui.alert({tone: 'danger', text: error}) }}{% endif %}
            {%- if step == 'request' %}
            <p>{{ t('Enter the email of your account. We send you a link to set a new password.') }}</p>
            <form class="fb-stack" method="post" action="{{ path('backend.password') }}">
                {{ ui.field({label: t('Email'), name: 'email', type: 'email', value: email, autocomplete: 'username', required: true, autofocus: true}) }}
                {{ ui.button({label: t('Send the link'), type: 'submit', block: true, variant: 'primary'}) }}
            </form>
            {%- elseif step == 'sent' %}
            {{ ui.alert({tone: 'success', text: t('If there is an account with {email}, a mail with a link is on its way. The link works for {minutes} minutes.', {email: email, minutes: minutes})}) }}
            <p class="fb-muted">{{ t('No mail? Look in the spam folder or ask the person who manages this website.') }}</p>
            {%- elseif step == 'reset' %}
            <form class="fb-stack" method="post" action="{{ path('backend.password.reset', {token: token}) }}">
                {#- For a password manager: the account the new password belongs to. -#}
                <input type="email" name="username" value="{{ email }}" autocomplete="username" hidden>
                <p>{{ t('Choose a new password for {email}.', {email: email}) }}</p>
                {{ ui.field({label: t('New password'), name: 'password', type: 'password', autocomplete: 'new-password', required: true, autofocus: true, hint: t('At least {min} characters.', {min: min}), attrs: {minlength: min}}) }}
                {{ ui.button({label: t('Save and sign in'), type: 'submit', block: true, variant: 'primary'}) }}
            </form>
            {%- elseif step == 'invalid' %}
            {{ ui.alert({tone: 'warning', text: t('This link does not work any more. It is older than {minutes} minutes or was used already.', {minutes: minutes})}) }}
            {{ ui.button({label: t('Ask for a new link'), href: path('backend.password'), block: true}) }}
            {%- else %}
            {{ ui.alert({tone: 'info', text: t('This website sends no links for a forgotten password. Ask the person who manages it for a new password.')}) }}
            {%- endif %}
        </div>
        <p class="fb-login__back"><a href="{{ path('backend.login') }}">{{ t('Back to sign in') }}</a></p>
    </div>
</main>
{% endblock %}
