{#- The details of one medium: focus point, texts per language, copyright (0203), AI label (0251), tags, folder (decision 0126), where it is used and its file replaced (0146), its draft (0147), the files of a video (0177), documents (0179). -#}
{% import '@backend/ui.twig' as ui %}
{% set editable = can('media.update') %}
{% set video = medium.kind == 'video' %}
{% set document = medium.kind == 'document' %}
{% set live = usages|filter(usage => usage.published)|length %}
<section class="fb-card fb-split__main" id="media-detail" aria-labelledby="media-detail-title">
    <div class="fb-card__header">
        <div class="fb-stack fb-stack--sm">
            <a class="fb-muted" href="{{ back }}">← {{ t('Back to the overview') }}</a>
            <h2 class="fb-heading-4" id="media-detail-title" tabindex="-1" data-fb-focus>{{ medium.fileName }}</h2>
            <p class="fb-muted">{% if video or document %}{{ medium.format }} · {% endif %}{% if medium.width > 0 %}{{ medium.width }} × {{ medium.height }} px · {% endif %}{{ medium.size >= 1048576 ? t('{size} MB', {size: (medium.size / 1048576)|round(1)}) : t('{size} KB', {size: max(1, (medium.size / 1024)|round)}) }} · {{ t('Uploaded') }} {{ ui.time(medium.createdAt) }}</p>
        </div>
        {% if medium.draft %}{{ ui.status('changed') }}{% else %}{{ medium.public ? ui.badge('published', t('Visible')) : ui.badge('draft', t('Not used on a published page yet')) }}{% endif %}
    </div>

    {% if medium.draft %}
    <div class="fb-card__body fb-stack fb-stack--sm">
        <p>{{ live > 0 ? t('Visitors see the changes once they are published. That changes the image in {count} published place.', {count: live}) : t('Visitors see the changes once they are published.') }}</p>
        <div class="fb-cluster">
            {% if can('media.publish') %}
            <fb-form action="media.publish" refresh="media-detail" done="{{ video ? t('The changes to the video are published.') : document ? t('The changes to the document are published.') : t('The changes to the image are published.') }}">
                <form novalidate>
                    <input type="hidden" name="ids[]" value="{{ medium.id }}">
                    {{ ui.button({label: t('Publish'), type: 'submit'}) }}
                </form>
            </fb-form>
            {% endif %}
            {% if can('media.discard') %}
            {{ ui.button({label: t('Discard the changes'), variant: 'danger', attrs: {commandfor: 'media-discard', command: 'show-modal'}}) }}
            {% endif %}
        </div>
    </div>
    {% elseif medium.public %}
    <div class="fb-card__body">
        <p class="fb-hint">{{ video or document ? t('Changes to the file and the texts wait in a draft until you publish them.') : t('Changes to the file, the focus point and the texts wait in a draft until you publish them.') }}</p>
    </div>
    {% endif %}

    {% if can('media.replace') %}
    <fb-upload class="fb-card__body fb-stack fb-stack--sm" url="{{ path('backend.uploads') }}" replace="{{ medium.id }}" refresh="media-detail" accept="{{ medium.kind }}" label="{{ video ? t('Drop a video here to replace the file') : document ? t('Drop a document here to replace the file') : t('Drop an image here to replace the file') }}" progress="{{ t('Uploading … {percent} %') }}" done="{{ medium.public ? t('The new file is in the draft.') : t('The file is replaced.') }}">
        <div class="fb-cluster">
            {{ ui.button({label: t('Replace the file'), variant: 'outline', attrs: {'data-fb-upload': true}}) }}
        </div>
        <p class="fb-hint">{{ video ? t('The new file counts at every place that uses the video. The further files stay.') : document ? t('The new file counts at every place that uses the document.') : t('The new file counts at every place that uses the image. The focus point stays.') }}</p>
        <p class="fb-visually-hidden" role="status" data-fb-upload-status></p>
    </fb-upload>
    {% endif %}

    {% if video %}
    <div class="fb-card__body fb-stack fb-stack--sm" id="media-sources">
        <video class="fb-media-video" src="{{ medium.preview }}" controls preload="metadata" playsinline{% if medium.width > 0 %} width="{{ medium.width }}" height="{{ medium.height }}"{% endif %}></video>
        <h3 class="fb-heading-4">{{ t('Further files') }}</h3>
        <p class="fb-hint">{{ t('The same video in other formats. Each browser plays the first file it can, the most efficient first.') }}</p>
        {% if medium.sources is not empty %}
        <ul class="fb-list">
            {%- for source in medium.sources %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <span class="fb-list__title">{{ source.format }}</span>
                    <span class="fb-list__meta">{% if source.width > 0 %}{{ source.width }} × {{ source.height }} px · {% endif %}{{ source.size >= 1048576 ? t('{size} MB', {size: (source.size / 1048576)|round(1)}) : t('{size} KB', {size: max(1, (source.size / 1024)|round)}) }}</span>
                </span>
                {% if can('media.source-delete') %}
                <fb-form action="media.source-delete" refresh="media-detail" done="{{ t('The file is deleted.') }}">
                    <form novalidate>
                        <input type="hidden" name="id" value="{{ medium.id }}">
                        <input type="hidden" name="sourceId" value="{{ source.id }}">
                        {{ ui.button({label: t('Delete {format}', {format: source.format}), variant: 'ghost', small: true, icon: 'trash', icon_only: true, type: 'submit'}) }}
                    </form>
                </fb-form>
                {% endif %}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
        {% set codecs = [medium.codec]|merge(medium.sources|map(source => source.codec)) %}
        {% if codecs|filter(codec => codec starts with 'avc')|length == 0 %}
        {{ ui.alert({tone: 'warning', text: t('Add a file in MP4 with H.264 (avc1). Every browser plays it, other formats not everywhere.')}) }}
        {% endif %}
        {% if can('media.source-add') %}
        <fb-upload class="fb-stack fb-stack--sm" url="{{ path('backend.uploads') }}" source="{{ medium.id }}" accept="video" refresh="media-detail" label="{{ t('Drop a video here to add it as a further file') }}" progress="{{ t('Uploading … {percent} %') }}" done="{{ t('The file is added.') }}">
            <div class="fb-cluster">
                {{ ui.button({label: t('Add a file'), variant: 'outline', icon: 'plus', attrs: {'data-fb-upload': true}}) }}
            </div>
            <p class="fb-visually-hidden" role="status" data-fb-upload-status></p>
        </fb-upload>
        {% endif %}
    </div>
    {% endif %}

    {% if document %}
    <div class="fb-card__body fb-cluster">
        {{ ui.button({label: t('Open the file'), variant: 'outline', icon: 'external', href: medium.preview, attrs: {target: '_blank', rel: 'noopener'}}) }}
    </div>
    {% endif %}

    <fb-form action="media.update" refresh="media-detail" done="{{ video ? t('The video is saved.') : document ? t('The document is saved.') : t('The image is saved.') }}">
        <form class="fb-card__body fb-stack" novalidate>
            <input type="hidden" name="id" value="{{ medium.id }}">
            {% if not video and not document %}
            <fb-focus class="fb-focus" x="{{ medium.focus.x }}" y="{{ medium.focus.y }}" label="{{ t('Focus point') }}" position="{{ t('{x} % from the left, {y} % from the top') }}"{% if not editable %} disabled{% endif %}>
                <img src="{{ medium.preview }}" alt="" width="{{ medium.width }}" height="{{ medium.height }}">
                <input type="hidden" name="focusX" data-type="number" value="{{ medium.focus.x }}">
                <input type="hidden" name="focusY" data-type="number" value="{{ medium.focus.y }}">
            </fb-focus>
            <p class="fb-hint">{{ t('Click on what matters most. Cut images keep this point in view.') }}</p>
            {% endif %}

            {% for language in languages %}
            {% set text = medium.texts[language.code] ?? {alt: '', title: ''} %}
            <fieldset class="fb-fieldset">
                {% if languages|length > 1 %}<legend class="fb-fieldset__legend">{{ language.title }}</legend>{% endif %}
                <div class="fb-stack fb-stack--sm">
                    {% if document %}
                    {{ ui.field({label: t('Title'), name: 'texts.' ~ language.code ~ '.title', id: 'media-title-' ~ language.code, value: text.title, optional: true, hint: t('Names the link to the document, e.g. “Price list 2027”. Without it the link shows the file name.'), disabled: not editable, attrs: {maxlength: 200, lang: language.code, dir: language.direction.value}}) }}
                    {% else %}
                    {{ ui.field({label: video ? t('Description') : t('Alternative text'), name: 'texts.' ~ language.code ~ '.alt', id: 'media-alt-' ~ language.code, value: text.alt, hint: video ? t('Names the video for people who cannot see it, e.g. “Film: How we roast”.') : t('Describes the image for people who cannot see it. Leave it empty for pure decoration.'), disabled: not editable, attrs: {maxlength: 500, lang: language.code, dir: language.direction.value}}) }}
                    {{ ui.field({label: t('Title'), name: 'texts.' ~ language.code ~ '.title', id: 'media-title-' ~ language.code, value: text.title, optional: true, disabled: not editable, attrs: {maxlength: 200, lang: language.code, dir: language.direction.value}}) }}
                    {% endif %}
                </div>
            </fieldset>
            {% endfor %}

            {{ ui.field({label: t('Copyright'), name: 'copyright', id: 'media-copyright', value: medium.copyright, optional: true, hint: t('Photographer or image agency, e.g. “Anna Muster / image agency”. The website shows it with the image where the theme provides for it.'), disabled: not editable, attrs: {maxlength: 300}}) }}

            {{ ui.select({label: t('AI'), name: 'ai', id: 'media-ai', options: [{value: 'none', label: t('Not made with AI')}, {value: 'generated', label: t('Generated with AI')}, {value: 'edited', label: t('Edited with AI')}], value: medium.ai, hint: not video and not document ? t('Images made or changed with AI show a small badge “AI” on the website. A file that says so sets it when uploaded.') : t('A file that says so sets it when uploaded.'), disabled: not editable}) }}
            {{ ui.field({label: t('Tags'), name: 'tags', id: 'media-tags', value: medium.tags|join("\n"), multiline: true, optional: true, hint: t('One per line, e.g. team or summer.'), disabled: not editable, attrs: {'data-type': 'lines', rows: 3}}) }}

            {% set options = [{value: '', label: t('Outside of folders')}] %}
            {% for row in folders %}{% set options = options|merge([{value: row.folder.id, label: row.indented}]) %}{% endfor %}
            {{ ui.select({label: t('Folder'), name: 'folderId', id: 'media-folder', options: options, value: medium.folderId ?? '', disabled: not editable}) }}

            {% if editable or can('media.delete') %}
            <div class="fb-cluster">
                {% if editable %}{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}{% endif %}
                {% if can('media.delete') %}{{ ui.button({label: t('Delete'), variant: 'danger', icon: 'trash', attrs: {commandfor: 'media-delete', command: 'show-modal'}}) }}{% endif %}
            </div>
            {% endif %}
        </form>
    </fb-form>

    <div class="fb-card__body fb-stack fb-stack--sm" id="media-usages">
        <h3 class="fb-heading-4">{{ t('Used on') }}</h3>
        {% if usages is empty %}
        <p class="fb-muted">{{ t('Not used anywhere, not even in a draft.') }}</p>
        {% else %}
        <ul class="fb-list">
            {%- for usage in usages %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    {% if usage.type == 'page' %}
                    <a class="fb-list__title fb-list__link" href="{{ path('backend.pages.show', {id: usage.id}) }}">{{ usage.title ?: t('Page without title') }}</a>
                    {% elseif usage.type == 'site' %}
                    <span class="fb-list__title">{{ t('Fields of the website') }}</span>
                    {% else %}
                    <span class="fb-list__title">{{ usage.title ?: t('Without title') }}</span>
                    {% endif %}
                    {% if usage.kind %}<span class="fb-list__meta">{{ t(usage.kind) }}</span>
                    {% elseif languages|length > 1 %}<span class="fb-list__meta">{{ (languages|filter(language => language.code == usage.language)|first).title ?? usage.language }}</span>{% endif %}
                </span>
                {{ usage.published ? ui.badge('published', t('Published')) : ui.badge('draft', t('Only in the draft')) }}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
    </div>
</section>

{% if medium.draft and can('media.discard') %}
<dialog class="fb-dialog" id="media-discard" aria-labelledby="media-discard-title">
    <fb-form action="media.discard" refresh="media-detail" done="{{ video ? t('The changes to the video are discarded.') : document ? t('The changes to the document are discarded.') : t('The changes to the image are discarded.') }}">
        <form novalidate>
            <input type="hidden" name="id" value="{{ medium.id }}">
            <div class="fb-dialog__body">
                <h2 class="fb-dialog__title" id="media-discard-title">{{ t('Discard the changes?') }}</h2>
                <p>{{ t('File, focus point and texts go back to what visitors see.') }}</p>
            </div>
            <div class="fb-dialog__actions">
                {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'media-discard', command: 'close', autofocus: true}}) }}
                {{ ui.button({label: t('Discard'), variant: 'danger-solid', type: 'submit'}) }}
            </div>
        </form>
    </fb-form>
</dialog>
{% endif %}

{% if can('media.delete') %}
<dialog class="fb-dialog" id="media-delete" aria-labelledby="media-delete-title">
    <fb-form action="media.delete" next="{{ back }}" done="{{ video ? t('The video is deleted.') : document ? t('The document is deleted.') : t('The image is deleted.') }}">
        <form novalidate>
            <input type="hidden" name="id" value="{{ medium.id }}">
            <div class="fb-dialog__body">
                {% if live > 0 %}
                <h2 class="fb-dialog__title" id="media-delete-title">{{ video ? t('The video cannot be deleted yet') : document ? t('The document cannot be deleted yet') : t('The image cannot be deleted yet') }}</h2>
                <p>{{ t('The image is used in {count} published place. Take it out there and publish, then delete it.', {count: live}) }}</p>
                {% else %}
                <h2 class="fb-dialog__title" id="media-delete-title">{{ video ? t('Delete the video?') : document ? t('Delete the document?') : t('Delete the image?') }}</h2>
                <p>{% if usages is empty %}{{ t('It is not used anywhere.') }}{% else %}{{ t('It is used in {count} draft. It shows nothing there any more.', {count: usages|length}) }}{% endif %}</p>
                {% endif %}
            </div>
            <div class="fb-dialog__actions">
                {% if live > 0 %}
                {{ ui.button({label: t('Close'), variant: 'outline', attrs: {commandfor: 'media-delete', command: 'close', autofocus: true}}) }}
                {% else %}
                {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'media-delete', command: 'close', autofocus: true}}) }}
                {{ ui.button({label: t('Delete'), variant: 'danger-solid', type: 'submit'}) }}
                {% endif %}
            </div>
        </form>
    </fb-form>
</dialog>
{% endif %}
