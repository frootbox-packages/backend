{#- The first screen after signing in. -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('Dashboard') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            {% if fb.site %}<p class="fb-muted">{{ fb.site }}</p>{% endif %}
            <h1 class="fb-heading-1">{{ t('Hello, {name}', {name: name}) }}</h1>
        </div>
    </header>

    {% if queue is not null %}{% include '@backend/jobs/cron.twig' with {status: queue, link: can('system.job-list')} %}{% endif %}

    <section class="fb-card fb-card--accent fb-callout" aria-labelledby="fb-edit-title">
        <div class="fb-callout__text">
            <h2 class="fb-heading-3" id="fb-edit-title">{{ t('You edit content right on the website') }}</h2>
            <p class="fb-muted">{{ t('You change texts, images and blocks where they are. Here you manage pages, media and settings.') }}</p>
        </div>
        {{ ui.button({label: t('Open the website'), href: '/', icon: 'external'}) }}
    </section>

    {% if pending is not null %}
    {#- Publishing all of them, then undoing it, loads this card again (decision 0176). #}
    <section class="fb-card" id="pending" aria-labelledby="fb-pending-title">
        <div class="fb-card__header">
            <h2 class="fb-heading-4" id="fb-pending-title" tabindex="-1" data-fb-focus>{{ t('Waiting to be published') }}</h2>
            {{ ui.badge('neutral', pending|length) }}
        </div>
        <div class="fb-card__body" id="pending-undo" hidden>
            {% set undo %}
                {%- if can('action.undo') -%}
                <fb-form action="action.undo" refresh="pending" done="{{ t('Undone. The changes are in the drafts again.') }}">
                    <form novalidate>
                        <input type="hidden" name="id" data-type="number" data-fb-entry>
                        {{ ui.button({label: t('Undo'), type: 'submit', variant: 'outline', small: true}) }}
                    </form>
                </fb-form>
                {%- endif -%}
            {% endset %}
            {{ ui.alert({tone: 'success', text: t('The pages are published.'), live: 'none', action: undo|trim ?: null}) }}
        </div>
        {% if pending is empty %}
            <p class="fb-card__body fb-muted">{{ t('Everything is published. New changes show up here until you publish them.') }}</p>
        {% else %}
            <ul>
                {%- for page in pending %}
                <li class="fb-list__item">
                    <span class="fb-list__main">
                        <a class="fb-list__title fb-list__link" href="{{ path('backend.pages.show', {id: page.id}) }}" lang="{{ page.lang }}" dir="{{ page.dir }}">{{ page.title }}</a>
                        <span class="fb-list__meta">{{ page.path }}</span>
                    </span>
                    {{ ui.status(page.status) }}
                    {%- if page.edit %}
                    <form method="post" action="{{ path('backend.edit-mode') }}" id="pending-edit-{{ page.id }}">
                        <input type="hidden" name="_csrf" value="{{ fb.csrf }}">
                        <input type="hidden" name="on" value="1">
                        <input type="hidden" name="next" value="{{ page.edit }}">
                        {{ ui.button({label: t('Edit'), type: 'submit', variant: 'outline', small: true, icon: 'pencil', attrs: {'aria-label': t('Edit {title} on the website', {title: page.title})}}) }}
                    </form>
                    {%- endif %}
                </li>
                {%- endfor %}
            </ul>
        {% endif %}
        {% if publishable is not empty %}
        {% set count = publishable|length %}
        {% set left_out = pending|filter(page => page.id not in publishable|column('id')) %}
        {% set scheduled = left_out|filter(page => page.status == 'scheduled') %}
        {% set refused = left_out|filter(page => page.status != 'scheduled') %}
        <div class="fb-card__footer">
            {{ ui.button({label: count == 1 ? t('Publish') : t('Publish all'), attrs: {commandfor: 'pending-publish', command: 'show-modal'}}) }}
        </div>
        <dialog class="fb-dialog" id="pending-publish" aria-labelledby="pending-publish-title">
            <fb-form action="page.publish" refresh="pending" show="pending-undo">
                <form novalidate>
                    <div class="fb-dialog__body">
                        <h2 class="fb-dialog__title" id="pending-publish-title">{{ t(['Publish {count} page?', 'Publish {count} pages?'], {count: count}) }}</h2>
                        <p>{{ t('Visitors then see these pages as they are in the draft. You can undo it right afterwards.') }}</p>
                        <ul>
                            {%- for page in publishable %}
                            <li class="fb-list__item" id="pending-publish-{{ page.id }}" tabindex="-1" data-fb-pointer="/ids/{{ loop.index0 }}" data-fb-label="{{ page.title }}">
                                <input type="hidden" name="ids[]" value="{{ page.id }}">
                                <div class="fb-list__main" data-fb-errors>
                                    <span class="fb-list__title" lang="{{ page.lang }}" dir="{{ page.dir }}">{{ page.title }}</span>
                                    <span class="fb-list__meta">{{ page.path }}</span>
                                </div>
                                {%- if page.edit %}
                                {{ ui.button({label: t('Edit'), type: 'submit', variant: 'ghost', small: true, icon: 'pencil', attrs: {form: 'pending-edit-' ~ page.id, 'aria-label': t('Edit {title} on the website', {title: page.title})}}) }}
                                {%- endif %}
                            </li>
                            {%- endfor %}
                        </ul>
                        {% if scheduled is not empty %}
                        <p class="fb-muted">{{ t('Not included, they go online at their scheduled time: {pages}.', {pages: scheduled|column('title')|join(', ')}) }}</p>
                        {% endif %}
                        {% if refused is not empty %}
                        <p class="fb-muted">{{ t('Not included, you may not publish them or a page above them: {pages}.', {pages: refused|column('title')|join(', ')}) }}</p>
                        {% endif %}
                    </div>
                    <div class="fb-dialog__actions">
                        {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'pending-publish', command: 'close', autofocus: true}}) }}
                        {{ ui.button({label: count == 1 ? t('Publish') : t('Publish all'), type: 'submit'}) }}
                    </div>
                </form>
            </fb-form>
        </dialog>
        {% endif %}
    </section>
    {% endif %}
</div>
{% endblock %}
