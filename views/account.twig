{#- The own account: name and email, language, password, links to providers, sessions and API tokens (decisions 0115, 0161, 0322, 0341). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('Your account') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <h1 class="fb-heading-1">{{ t('Your account') }}</h1>
            <p class="fb-muted">{{ profile.user.name }} · {{ profile.user.email }}</p>
        </div>
    </header>

    {% if emailChanged %}{{ ui.alert({tone: 'success', text: t('Your email is changed. Sign in with it from now on.')}) }}{% endif %}

    <section class="fb-card" aria-labelledby="fb-profile-title">
        <div class="fb-card__header"><h2 class="fb-heading-4" id="fb-profile-title">{{ t('Name and email') }}</h2></div>
        <div class="fb-card__body fb-stack fb-stack--lg">
            <fb-form action="account.update" next="{{ path('backend.account') }}" done="{{ t('Your name is changed.') }}">
                <form class="fb-stack" novalidate>
                    {{ ui.field({label: t('Name'), name: 'name', id: 'account-name', value: profile.user.name, required: true, autocomplete: 'name'}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Save the name'), type: 'submit'}) }}</div>
                </form>
            </fb-form>
            {#- With the password and a link to the new address (decision 0341). -#}
            <fb-form action="account.request-email-change" {% if mailLinks %}reset{% else %}next="{{ path('backend.account') }}"{% endif %} done="{{ mailLinks ? t('A mail with a link is on its way to the new email. It changes once you open the link.') : t('Your email is changed. Sign in with it from now on.') }}">
                <form class="fb-stack" novalidate>
                    {{ ui.field({label: t('New email'), name: 'email', id: 'account-email', type: 'email', required: true, autocomplete: 'email', hint: mailLinks ? t('You sign in with it once you confirm it with the link in a mail to it.') : t('You sign in with it from now on.')}) }}
                    {{ ui.field({label: t('Current password'), name: 'password', id: 'account-email-password', type: 'password', required: true, autocomplete: 'current-password'}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Change the email'), type: 'submit'}) }}</div>
                </form>
            </fb-form>
        </div>
    </section>

    <section class="fb-card" aria-labelledby="fb-language-title">
        <div class="fb-card__header"><h2 class="fb-heading-4" id="fb-language-title">{{ t('Language') }}</h2></div>
        <div class="fb-card__body">
            {%- set standard = (languages.languages|filter(language => language.code == languages.standard)|first).name ?? languages.standard -%}
            <fb-form action="account.update-language" next="{{ path('backend.account') }}" done="{{ t('The language is changed.') }}">
                <form class="fb-stack" novalidate>
                    {{ ui.select({label: t('Language of the backend'), name: 'language', value: languages.chosen ?? '', attrs: {'data-empty': 'null'},
                        hint: t('Only for you. The languages of the website stay as they are.'),
                        options: [{value: '', label: t('Automatic ({language})', {language: standard})}]|merge(languages.languages|map(language => {value: language.code, label: language.name, attrs: {lang: language.code}}))}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit'}) }}</div>
                </form>
            </fb-form>
        </div>
    </section>

    <section class="fb-card" aria-labelledby="fb-password-title">
        <div class="fb-card__header"><h2 class="fb-heading-4" id="fb-password-title">{{ t('Change the password') }}</h2></div>
        <div class="fb-card__body">
            <fb-form action="account.change-password" reset done="{{ t('Your password is changed. Other devices are signed out.') }}">
                <form class="fb-stack" novalidate>
                    {{ ui.field({label: t('Current password'), name: 'currentPassword', type: 'password', autocomplete: 'current-password', required: true}) }}
                    {{ ui.field({label: t('New password'), name: 'newPassword', type: 'password', autocomplete: 'new-password', required: true, hint: t('At least 10 characters. A few words in a row are easy to remember.')}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Change the password'), type: 'submit'}) }}</div>
                </form>
            </fb-form>
        </div>
    </section>

    {%- set linkable = providers|filter(p => p.key not in identities|map(i => i.provider)) %}
    {% if identities is not empty or linkable is not empty %}
    <section class="fb-card" aria-labelledby="fb-identities-title">
        <div class="fb-card__header">
            <div class="fb-stack fb-stack--sm">
                <h2 class="fb-heading-4" id="fb-identities-title">{{ t('Sign in with another account') }}</h2>
                <p class="fb-muted">{{ t('Linked, you sign in here with your account there. Your password stays.') }}</p>
            </div>
        </div>
        {% if oidcError %}<div class="fb-card__body">{{ ui.alert({tone: 'danger', text: oidcError}) }}</div>{% endif %}
        <ul>
            {%- for identity in identities %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <span class="fb-list__title">{{ identity.title }}</span>
                    <span class="fb-list__meta">
                        {{- identity.managed ? t('Managed through {provider}: your role comes from there.', {provider: identity.title}) : t('Linked {date}', {date: identity.createdAt|date(t('Y-m-d'))}) -}}
                        {%- if identity.lastUsedAt %} · {{ t('Last used {date}', {date: identity.lastUsedAt|date(t('Y-m-d H:i'))}) }}{% endif -%}
                    </span>
                </span>
                {% if not identity.managed %}
                <fb-form action="account.oidc-unlink" next="{{ path('backend.account') }}" done="{{ t('The link is removed.') }}">
                    <form novalidate>
                        <input type="hidden" name="provider" value="{{ identity.provider }}">
                        {{ ui.button({label: t('Unlink'), variant: 'outline', small: true, type: 'submit', attrs: {'aria-label': t('Remove the link to {provider}', {provider: identity.title})}}) }}
                    </form>
                </fb-form>
                {% endif %}
            </li>
            {%- endfor %}
            {%- for provider in linkable %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <span class="fb-list__title">{{ provider.title }}</span>
                    <span class="fb-list__meta">{{ t('Not linked') }}</span>
                </span>
                <form method="post" action="{{ path('backend.oidc.link', {provider: provider.key}) }}">
                    <input type="hidden" name="_csrf" value="{{ fb.csrf }}">
                    {{ ui.button({label: t('Link with {provider}', {provider: provider.title}), variant: 'outline', small: true, type: 'submit', icon: 'external'}) }}
                </form>
            </li>
            {%- endfor %}
        </ul>
    </section>
    {% endif %}

    <section class="fb-card" aria-labelledby="fb-sessions-title">
        <div class="fb-card__header">
            <h2 class="fb-heading-4" id="fb-sessions-title">{{ t('Where you are signed in') }}</h2>
        </div>
        <ul>
            {%- for session in sessions %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <span class="fb-list__title" title="{{ session.name }}">{{ device(session.name) ?? t('Unknown device') }}</span>
                    <span class="fb-list__meta">{{ t('Last used {date}', {date: (session.lastUsedAt ?? session.createdAt)|date(t('Y-m-d H:i'))}) }}
                        {%- if session.provider %} · {{ t('through {provider}', {provider: (providers|filter(p => p.key == session.provider)|first).title ?? session.provider}) }}{% endif %}</span>
                </span>
                {% if session.id == current %}
                    {{ ui.badge('neutral', t('This device')) }}
                {% else %}
                    <fb-form action="account.revoke-token" next="{{ path('backend.account') }}" done="{{ t('The session is ended.') }}">
                        <form novalidate>
                            <input type="hidden" name="id" value="{{ session.id }}" data-type="number">
                            {{ ui.button({label: t('Sign out'), variant: 'outline', small: true, type: 'submit', attrs: {'aria-label': t('Sign out {device}', {device: device(session.name) ?? t('Unknown device')})}}) }}
                        </form>
                    </fb-form>
                {% endif %}
            </li>
            {%- endfor %}
        </ul>
    </section>

    <section class="fb-card" aria-labelledby="fb-tokens-title">
        <div class="fb-card__header">
            <div class="fb-stack fb-stack--sm">
                <h2 class="fb-heading-4" id="fb-tokens-title">{{ t('API tokens') }}</h2>
                <p class="fb-muted">{{ t('Scripts and apps use a token to act with your permissions.') }}</p>
            </div>
        </div>
        {% if tokens is not empty %}
        <ul>
            {%- for token in tokens %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <span class="fb-list__title">{{ token.name }}</span>
                    <span class="fb-list__meta">
                        {{- token.lastUsedAt ? t('Last used {date}', {date: token.lastUsedAt|date(t('Y-m-d H:i'))}) : t('Not used yet') -}}
                        {%- if token.expiresAt %} · {{ t('Valid until {date}', {date: token.expiresAt|date(t('Y-m-d'))}) }}{% endif -%}
                    </span>
                </span>
                <fb-form action="account.revoke-token" next="{{ path('backend.account') }}" done="{{ t('The token is revoked.') }}">
                    <form novalidate>
                        <input type="hidden" name="id" value="{{ token.id }}" data-type="number">
                        {{ ui.button({label: t('Revoke'), variant: 'danger', small: true, type: 'submit', attrs: {'aria-label': t('Revoke {token}', {token: token.name})}}) }}
                    </form>
                </fb-form>
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
        <div class="fb-card__footer fb-card__footer--stack">
            <fb-form action="account.create-token" show="fb-new-token" reset>
                <form class="fb-stack" novalidate>
                    {{ ui.field({label: t('New token for'), name: 'name', required: true, placeholder: t('e.g. Deploy script')}) }}
                    {{ ui.field({label: t('Valid for days'), name: 'days', type: 'number', optional: true, hint: t('Empty: until you revoke it.'), attrs: {min: 1, max: 3650, inputmode: 'numeric'}}) }}
                    <div class="fb-form__actions">{{ ui.button({label: t('Create the token'), variant: 'outline', type: 'submit', icon: 'plus'}) }}</div>
                </form>
            </fb-form>
            <div class="fb-stack fb-stack--sm" id="fb-new-token" hidden>
                {{ ui.alert({tone: 'warning', title: t('Copy the token now'), text: t('It is shown only this once. Whoever has it acts as you.')}) }}
                <code class="fb-secret" data-fb-value="token"></code>
                <div>{{ ui.button({label: t('Done'), variant: 'outline', href: path('backend.account')}) }}</div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
