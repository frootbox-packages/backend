{#
    The building blocks of the backend as macros (decision 0113). Every
    screen uses these, never its own markup for the same thing. DESIGN.md
    describes each one with its options.

        {% import '@backend/ui.twig' as ui %}
        {{ ui.button({label: t('Save'), type: 'submit'}) }}
#}

{# Extra attributes: true writes the name only, false and null nothing. #}
{% macro attributes(attrs) -%}
    {%- for name, value in attrs -%}
        {%- if value is same as(true) %} {{ name }}{% elseif value is not same as(false) and value is not null %} {{ name }}="{{ value }}"{% endif -%}
    {%- endfor -%}
{%- endmacro %}

{#
    variant: primary (one per screen at rest), tonal (important second actions),
    outline, ghost, danger, danger-solid (decision 0131)
    saves: the save button of a form that edits something, tonal at rest and
    primary while the form is changed (decision 0130)
    type: button, submit; href makes it a link
    icon: name in assets/icons; icon_only hides the label visually
#}
{% macro button(options) -%}
    {%- set o = {label: '', variant: (options.saves ?? false) ? 'tonal' : 'primary', type: 'button', href: null, icon: null, icon_only: false, small: false, block: false, disabled: false, saves: false, attrs: {}}|merge(options) -%}
    {%- set o = o|merge({attrs: o.saves ? o.attrs|merge({'data-fb-saves': true}) : o.attrs}) -%}
    {%- set classes = ['fb-button', 'fb-button--' ~ o.variant]
        |merge(o.small ? ['fb-button--small'] : [])
        |merge(o.block ? ['fb-button--block'] : [])
        |merge(o.icon_only ? ['fb-button--icon'] : []) -%}
    {%- set content -%}
        {%- if o.icon %}{{ icon(o.icon) }}{% endif -%}
        <span{% if o.icon_only %} class="fb-visually-hidden"{% endif %}>{{ o.label }}</span>
    {%- endset -%}
    {%- if o.href is not null -%}
        <a class="{{ classes|join(' ') }}" href="{{ o.href }}"{% if o.icon_only %} title="{{ o.label }}"{% endif %}{% if o.disabled %} aria-disabled="true"{% endif %}{{ _self.attributes(o.attrs) }}>{{ content }}</a>
    {%- else -%}
        <button class="{{ classes|join(' ') }}" type="{{ o.type }}"{% if o.icon_only %} title="{{ o.label }}"{% endif %}{% if o.disabled %} disabled{% endif %}{{ _self.attributes(o.attrs) }}>{{ content }}</button>
    {%- endif -%}
{%- endmacro %}

{# Label, hint and error belong to the field and are linked by id. #}
{% macro field(options) -%}
    {%- set o = {label: '', name: '', id: null, type: 'text', value: '', hint: null, error: null, prefix: null, required: false, optional: false, disabled: false, placeholder: null, autocomplete: null, autofocus: false, multiline: false, attrs: {}}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name) -%}
    {%- set described = [o.hint ? id ~ '-hint' : null, o.error ? id ~ '-error' : null]|filter(v => v) -%}
    {%- set attrs = {
        id: id,
        name: o.name,
        required: o.required,
        disabled: o.disabled,
        placeholder: o.placeholder,
        autocomplete: o.autocomplete,
        autofocus: o.autofocus,
        'aria-invalid': o.error ? 'true' : null,
        'aria-describedby': described ? described|join(' ') : null,
    }|merge(o.attrs) -%}
    <div class="fb-field">
        <label class="fb-label" for="{{ id }}">{{ o.label }}{% if o.optional %} <span class="fb-label__optional">({{ t('optional') }})</span>{% endif %}</label>
        {%- set input -%}
            {%- if o.multiline -%}
                <textarea class="fb-input"{{ _self.attributes(attrs) }}>{{ o.value }}</textarea>
            {%- else -%}
                <input class="fb-input" type="{{ o.type }}"{% if o.type != 'password' %} value="{{ o.value }}"{% endif %}{{ _self.attributes(attrs) }}>
            {%- endif -%}
        {%- endset -%}
        {%- if o.prefix is not null -%}
            <div class="fb-affix"><span class="fb-affix__text">{{ o.prefix }}</span>{{ input }}</div>
        {%- else -%}
            {{ input }}
        {%- endif -%}
        {%- if o.hint %}<p class="fb-hint" id="{{ id }}-hint">{{ o.hint }}</p>{% endif -%}
        {%- if o.error %}<p class="fb-error" id="{{ id }}-error">{{ icon('alert', 'fb-icon fb-icon--small') }}<span>{{ o.error }}</span></p>{% endif -%}
    </div>
{%- endmacro %}

{# Rich text as Tiptap JSON (decision 0220): value is the document, lang and dir the language of the text. #}
{% macro richtext(options) -%}
    {%- set o = {label: '', name: '', id: null, value: null, hint: null, error: null, optional: false, disabled: false, lang: null, dir: null}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name) -%}
    {%- set labels = {formatting: t('Formatting'), heading: t('Heading'), subheading: t('Subheading'), bold: t('Bold'), italic: t('Italic'), list: t('List'), ordered: t('Numbered list'), quote: t('Quote'), link: t('Link'), address: t('Address of the link'), apply: t('Apply'), remove: t('Remove the link'), cancel: t('Cancel'), loading: t('Loading the editor …')} -%}
    <div class="fb-field">
        <span class="fb-label" id="{{ id }}-label">{{ o.label }}{% if o.optional %} <span class="fb-label__optional">({{ t('optional') }})</span>{% endif %}</span>
        <fb-rich-text labelledby="{{ id }}-label" labels="{{ labels|json_encode }}"{{ _self.attributes({lang: o.lang, dir: o.dir}) }}>
            <input type="hidden" data-type="json"{{ _self.attributes({id: id, name: o.name, disabled: o.disabled}) }} value="{{ (o.value ?? {type: 'doc', content: []})|json_encode }}">
        </fb-rich-text>
        {%- if o.hint %}<p class="fb-hint" id="{{ id }}-hint">{{ o.hint }}</p>{% endif -%}
        {%- if o.error %}<p class="fb-error" id="{{ id }}-error">{{ icon('alert', 'fb-icon fb-icon--small') }}<span>{{ o.error }}</span></p>{% endif -%}
    </div>
{%- endmacro %}

{# An image from the media as {media, alt} (decision 0220): preview and file show the current one. #}
{% macro image(options) -%}
    {%- set o = {label: '', name: '', id: null, value: null, preview: null, file: null, hint: null, error: null, optional: false, disabled: false}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name) -%}
    {%- set labels = {choose: t('Choose an image'), change: t('Change'), remove: t('Remove'), title: t('Choose an image'), search: t('Search the media'), more: t('Show more'), close: t('Close'), alt: t('Alternative text'), altHint: t('What the image shows, for people who cannot see it.'), none: t('No images found.'), loading: t('Loading …'), failed: t('The media could not be loaded. Try again.')} -%}
    <div class="fb-field">
        <span class="fb-label" id="{{ id }}-label">{{ o.label }}{% if o.optional %} <span class="fb-label__optional">({{ t('optional') }})</span>{% endif %}</span>
        <fb-image-input role="group" aria-labelledby="{{ id }}-label" src="{{ path('backend.query', {name: 'media.list'}) }}" labels="{{ labels|json_encode }}"{{ _self.attributes({preview: o.preview, file: o.file}) }}>
            <input type="hidden" data-type="json"{{ _self.attributes({id: id, name: o.name, disabled: o.disabled}) }} value="{{ (o.value is empty ? {} : o.value)|json_encode }}">
        </fb-image-input>
        {%- if o.hint %}<p class="fb-hint" id="{{ id }}-hint">{{ o.hint }}</p>{% endif -%}
        {%- if o.error %}<p class="fb-error" id="{{ id }}-error">{{ icon('alert', 'fb-icon fb-icon--small') }}<span>{{ o.error }}</span></p>{% endif -%}
    </div>
{%- endmacro %}

{# A file from the media to download as {media, text} (decision 0250): file shows the name of the current one. #}
{% macro file(options) -%}
    {%- set o = {label: '', name: '', id: null, value: null, file: null, hint: null, error: null, optional: false, disabled: false}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name) -%}
    {%- set labels = {choose: t('Choose a file'), change: t('Change'), remove: t('Remove'), title: t('Choose a file'), search: t('Search the media'), more: t('Show more'), close: t('Close'), text: t('Text of the link'), textHint: t('Empty for the title of the file.'), none: t('No files found.'), loading: t('Loading …'), failed: t('The media could not be loaded. Try again.')} -%}
    <div class="fb-field">
        <span class="fb-label" id="{{ id }}-label">{{ o.label }}{% if o.optional %} <span class="fb-label__optional">({{ t('optional') }})</span>{% endif %}</span>
        <fb-image-input kind="document" role="group" aria-labelledby="{{ id }}-label" src="{{ path('backend.query', {name: 'media.list'}) }}" labels="{{ labels|json_encode }}"{{ _self.attributes({file: o.file}) }}>
            <input type="hidden" data-type="json"{{ _self.attributes({id: id, name: o.name, disabled: o.disabled}) }} value="{{ (o.value is empty ? {} : o.value)|json_encode }}">
        </fb-image-input>
        {%- if o.hint %}<p class="fb-hint" id="{{ id }}-hint">{{ o.hint }}</p>{% endif -%}
        {%- if o.error %}<p class="fb-error" id="{{ id }}-error">{{ icon('alert', 'fb-icon fb-icon--small') }}<span>{{ o.error }}</span></p>{% endif -%}
    </div>
{%- endmacro %}

{# options: list of {value, label}, optional attrs per option. #}
{% macro select(options) -%}
    {%- set o = {label: '', name: '', id: null, options: [], value: null, hint: null, error: null, disabled: false, attrs: {}}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name) -%}
    {%- set described = [o.hint ? id ~ '-hint' : null, o.error ? id ~ '-error' : null]|filter(v => v) -%}
    <div class="fb-field">
        <label class="fb-label" for="{{ id }}">{{ o.label }}</label>
        <div class="fb-select">
            <select class="fb-input"{{ _self.attributes({id: id, name: o.name, disabled: o.disabled, 'aria-invalid': o.error ? 'true' : null, 'aria-describedby': described ? described|join(' ') : null}|merge(o.attrs)) }}>
                {%- for option in o.options -%}
                    <option value="{{ option.value }}"{% if option.value == o.value %} selected{% endif %}{{ _self.attributes(option.attrs ?? {}) }}>{{ option.label }}</option>
                {%- endfor -%}
            </select>
            {{ icon('chevron-down') }}
        </div>
        {%- if o.hint %}<p class="fb-hint" id="{{ id }}-hint">{{ o.hint }}</p>{% endif -%}
        {%- if o.error %}<p class="fb-error" id="{{ id }}-error">{{ icon('alert', 'fb-icon fb-icon--small') }}<span>{{ o.error }}</span></p>{% endif -%}
    </div>
{%- endmacro %}

{# A checkbox or, with type radio, a radio button with its label on the right. #}
{% macro check(options) -%}
    {%- set o = {label: '', name: '', id: null, type: 'checkbox', value: '1', checked: false, hint: null, disabled: false, attrs: {}}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name ~ '-' ~ o.value) -%}
    <label class="fb-check" for="{{ id }}">
        <input type="{{ o.type }}"{{ _self.attributes({id: id, name: o.name, value: o.value, checked: o.checked, disabled: o.disabled}|merge(o.attrs)) }}>
        <span class="fb-check__text"><span>{{ o.label }}</span>{% if o.hint %}<span class="fb-hint">{{ o.hint }}</span>{% endif %}</span>
    </label>
{%- endmacro %}

{# A radio button as a card with a title and a description. #}
{% macro choice(options) -%}
    {%- set o = {title: '', text: null, name: '', id: null, value: '', checked: false, attrs: {}}|merge(options) -%}
    {%- set id = o.id ?? ('field-' ~ o.name ~ '-' ~ o.value) -%}
    <label class="fb-choice" for="{{ id }}">
        <input type="radio"{{ _self.attributes({id: id, name: o.name, value: o.value, checked: o.checked}|merge(o.attrs)) }}>
        <span class="fb-choice__text"><span class="fb-choice__title">{{ o.title }}</span>{% if o.text %}<span class="fb-hint">{{ o.text }}</span>{% endif %}</span>
    </label>
{%- endmacro %}

{# status: published, draft, changed, scheduled, danger or neutral (no dot). #}
{% macro badge(status, label) -%}
    <span class="fb-badge" data-status="{{ status }}">{{ label }}</span>
{%- endmacro %}

{# The status of a page with its usual label. #}
{% macro status(status) -%}
    {%- set labels = {published: t('Published'), draft: t('Draft'), changed: t('Pending changes'), scheduled: t('Scheduled')} -%}
    {{ _self.badge(status, labels[status] ?? status) }}
{%- endmacro %}

{# tone: info, success, warning, danger. Danger is read out at once. #}
{% macro alert(options) -%}
    {%- set o = {tone: 'info', title: null, text: '', live: null, action: null}|merge(options) -%}
    {%- set icons = {info: 'info', success: 'check', warning: 'warning', danger: 'alert'} -%}
    <div class="fb-alert" data-tone="{{ o.tone }}" role="{{ o.live ?? (o.tone == 'danger' ? 'alert' : 'status') }}">
        {{ icon(icons[o.tone] ?? 'info') }}
        <div>{% if o.title %}<p class="fb-alert__title">{{ o.title }}</p>{% endif %}<p>{{ o.text }}</p></div>
        {%- if o.action %}<div class="fb-alert__action">{{ o.action }}</div>{% endif %}
    </div>
{%- endmacro %}

{# A confirmation that goes away by itself; static shows it in the page. #}
{% macro toast(text, static = false) -%}
    <div class="fb-toast{% if static %} fb-toast--static{% endif %}" role="status">{{ icon('check') }}<span>{{ text }}</span></div>
{%- endmacro %}

{# tabs: list of {label, href, current}. #}
{% macro tabs(label, tabs) -%}
    <nav class="fb-tabs" aria-label="{{ label }}">
        {%- for tab in tabs -%}
            <a class="fb-tabs__tab" href="{{ tab.href }}"{% if tab.current ?? false %} aria-current="page"{% endif %}{{ _self.attributes(tab.attrs ?? {}) }}>{{ tab.label }}</a>
        {%- endfor -%}
    </nav>
{%- endmacro %}

{# Links in the look of a segmented control, e.g. the languages in the header of a screen with tab panels (decision 0235). They keep the open tab. #}
{% macro segmented(label, items) -%}
    <nav class="fb-segmented fb-segmented--links" aria-label="{{ label }}">
        {%- for item in items -%}
            <a class="fb-segmented__item" href="{{ item.href }}" data-fb-keeps-tab{% if item.current ?? false %} aria-current="page"{% endif %}{{ _self.attributes(item.attrs ?? {}) }}>{{ item.label }}</a>
        {%- endfor -%}
    </nav>
{%- endmacro %}

{# What is missing and the way to the first entry. action: options of button(). #}
{% macro empty(options) -%}
    {%- set o = {icon: 'inbox', title: '', text: null, action: null}|merge(options) -%}
    <div class="fb-empty">
        <span class="fb-empty__icon">{{ icon(o.icon) }}</span>
        <p class="fb-empty__title">{{ o.title }}</p>
        {% if o.text %}<p class="fb-empty__text">{{ o.text }}</p>{% endif %}
        {% if o.action %}{{ _self.button(o.action) }}{% endif %}
    </div>
{%- endmacro %}

{# A time, shown in the time zone of the browser (time.js); the server zone without JavaScript. #}
{% macro time(datetime) -%}
    <time datetime="{{ datetime|date('c') }}" data-fb-time>{{ datetime|date(t('Y-m-d H:i')) }}</time>
{%- endmacro %}

{# A whole number with the separators of the language, e.g. 1.234 in German. #}
{% macro number(value) -%}
    {{ value|number_format(0, t('.'), t(',')) }}
{%- endmacro %}

{# Key figures side by side. figures: list of {label, value, note}; value is shown as given, e.g. from number(). #}
{% macro figures(figures) -%}
    <dl class="fb-figures">
        {%- for figure in figures -%}
            <div class="fb-figure"><dt class="fb-figure__label">{{ figure.label }}</dt><dd class="fb-figure__value">{{ figure.value }}</dd>{% if figure.note ?? null %}<dd class="fb-figure__note">{{ figure.note }}</dd>{% endif %}</div>
        {%- endfor -%}
    </dl>
{%- endmacro %}

{# Columns, e.g. visits per day. label: the caption; items: list of {label, value}, oldest first. #}
{% macro chart(options) -%}
    {%- set o = {label: '', items: []}|merge(options) -%}
    {%- set most = max([1]|merge(o.items|map(item => item.value))) -%}
    <figure class="fb-chart">
        <figcaption class="fb-chart__caption">{{ o.label }}</figcaption>
        <ol class="fb-chart__bars">
            {%- for item in o.items -%}
                <li class="fb-chart__item" style="--fb-chart-value: {{ (item.value / most)|round(3) }}" title="{{ item.label }}: {{ _self.number(item.value) }}"><span class="fb-chart__bar"></span><span class="fb-visually-hidden">{{ item.label }}: {{ _self.number(item.value) }}</span></li>
            {%- endfor -%}
        </ol>
        {%- if o.items %}<p class="fb-chart__axis" aria-hidden="true"><span>{{ (o.items|first).label }}</span><span>{{ (o.items|last).label }}</span></p>{% endif %}
    </figure>
{%- endmacro %}

{# A number with a bar for its share of the largest, e.g. at the end of a list item. #}
{% macro share(value, most) -%}
    <span class="fb-share" style="--fb-share: {{ most > 0 ? (value / most)|round(3) : 0 }}"><span class="fb-share__bar" aria-hidden="true"></span><span class="fb-share__value">{{ _self.number(value) }}</span></span>
{%- endmacro %}

{# The initials of a user, hidden from screen readers: the name is next to them. #}
{% macro avatar(initials) -%}
    <span class="fb-avatar" aria-hidden="true">{{ initials }}</span>
{%- endmacro %}

{# The logo of the active brand for light and dark, else its name. #}
{% macro brand(fb, href = null) -%}
    {%- set inner -%}
        {%- if fb.logo -%}
            <img class="fb-brand__logo fb-brand__logo--light" src="{{ fb.logo }}" alt="{{ fb.brand }}">
            <img class="fb-brand__logo fb-brand__logo--dark" src="{{ fb.logoDark ?? fb.logo }}" alt="{{ fb.brand }}">
        {%- else -%}
            <span>{{ fb.brand }}</span>
        {%- endif -%}
    {%- endset -%}
    {%- if href -%}
        <a class="fb-brand" href="{{ href }}">{{ inner }}</a>
    {%- else -%}
        <span class="fb-brand">{{ inner }}</span>
    {%- endif -%}
{%- endmacro %}

{#- The search of the backend (decision 0217): a link to its screen that opens the dialog, with Ctrl+K or ⌘+K from anywhere. -#}
{% macro search(href, shortcut = true) -%}
<fb-search src="{{ href }}"{% if shortcut %} shortcut{% endif %} labels="{{ {
    search: t('Search'),
    placeholder: t('Search pages, media, users …'),
    close: t('Close'),
    searching: t('Searching …'),
    none: t('Nothing found for “{q}”.'),
    found: t('{count} hits'),
    failed: t('The search did not answer. Try again.'),
    all: t('Show all hits'),
    hint: t('↑ ↓ to choose, ↵ to open, Esc to close'),
}|json_encode }}">
    <a class="fb-nav__item fb-nav__item--small fb-nav__item--search" href="{{ href }}" aria-keyshortcuts="Control+K Meta+K">{{ icon('search', 'fb-icon fb-icon--small') }}<span>{{ t('Search') }}</span><kbd class="fb-nav__keys" data-fb-keys>Ctrl K</kbd></a>
</fb-search>
{%- endmacro %}

{#- The help about a screen as a panel at its side (decision 0218); without a page about it a link to the help. -#}
{% macro help(link, base) -%}
{%- if link -%}
<fb-help src="{{ link.url }}" base="{{ base }}" labels="{{ {help: t('Help'), close: t('Close'), open: t('Open in the help'), loading: t('Loading …'), failed: t('The help could not be loaded. Try again.'), english: t('This page is only available in English so far.')}|json_encode }}">
    {{- _self.button({label: t('Help: {title}', {title: link.title}), href: link.url, variant: 'ghost', small: true, icon: 'info'}) -}}
</fb-help>
{%- else -%}
    {{- _self.button({label: t('Help'), href: base, variant: 'ghost', small: true, icon: 'info'}) -}}
{%- endif -%}
{%- endmacro %}
