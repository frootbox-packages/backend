{
    "name": "frootbox/backend",
    "description": "Backend of the Frootbox CMS: the screens behind backend.path and the user interface of the edit mode",
    "type": "frootbox-extension",
    "license": "LGPL-3.0-only",
    "keywords": [
        "cms",
        "frootbox",
        "backend"
    ],
    "require": {
        "php": ">=8.5",
        "frootbox/core": "^0.1",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "Frootbox\\Backend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\Backend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
